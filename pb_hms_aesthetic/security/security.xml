<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="group_hms_aesthetic" model="res.groups">
        <field name="name">Aesthetic User</field>
        <field name="implied_ids" eval="[(4, ref('pb_hms.group_hms_receptionist'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <record id="hms_pb_aesthetic_wish_portal_rule" model="ir.rule">
            <field name="name">Portal Patient's Own Aesthetic Wish</field>
            <field name="model_id" ref="pb_hms_aesthetic.model_pb_aesthetic_patient_wish"/>
            <field name="domain_force">[('patient_id.partner_id','=',user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
        </record>

    </data>
</odoo>