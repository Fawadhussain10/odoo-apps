<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">

    <record id="ir_cron_recurring_procedures" model="ir.cron">
        <field name="name">Procedure: Create Recurring Procedures</field>
        <field name="model_id" ref="pb_hms_recurring_procedure.model_pb_procedure_recurrence"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_recurring_procedures()</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>