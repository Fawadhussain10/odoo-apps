<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Ophthalmology Finding -->
    <record id="view_pb_ophthalmology_finding_tree" model="ir.ui.view">
        <field name="name">pb.ophthalmology.finding.tree</field>
        <field name="model">pb.ophthalmology.finding</field>
        <field name="arch" type="xml">
            <list string="Ophthalmology Finding" editable="bottom">
                <field name="eye_structure"/>
                <field name="affected_eye"/>
                <field name="finding"/>
            </list>
        </field>
    </record>

    <!-- Ophthalmology Evaluation -->
    <record id="view_pb_ophthalmology_evaluation_search" model="ir.ui.view">
        <field name="name">pb.ophthalmology.evaluation.search</field>
        <field name="model">pb.ophthalmology.evaluation</field>
        <field name="arch" type="xml">
            <search string="Ophthalmology Evaluation">
                <field name="name"/>
                <field name="physician_id"/>
                <field name="patient_id"/>
                <newline/>
                <group>
                    <filter string="State" name="state_groupby" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pb_ophthalmology_evaluation_tree" model="ir.ui.view">
        <field name="name">pb.ophthalmology.evaluation.tree</field>
        <field name="model">pb.ophthalmology.evaluation</field>
        <field name="arch" type="xml">
            <list string="Ophthalmology Evaluation" decoration-muted="state=='done'" decoration-info="state=='in_rogress'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="age"/>
                <field name="physician_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pb_ophthalmology_evaluation_form" model="ir.ui.view">
        <field name="name">pb.ophthalmology.evaluation.form</field>
        <field name="model">pb.ophthalmology.evaluation</field>
        <field name="arch" type="xml">
            <form string="Ophthalmology Evaluation">
                <header>
                    <button name="action_inprogress" invisible="state not in ('draft',)" string="Start Evaluation" type="object" class="oe_highlight"/>
                    <button name="action_done" invisible="state not in ('in_progress',)" string="Done" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progree,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="date"/>
                            <field name="appointment_id"/>
                        </group>
                        <group>
                            <field name="physician_id"/>
                            <field name="age"/>
                            <field name="diseases_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="optometry" string="Optometry">
                            <separator string="Refraction"/>
                            <group name="dva_details">
                                <group string="Right Eye" name="rdva_details">
                                    <field name="rdva"/>
                                    <field name="rdva_pinhole"/>
                                    <field name="rdva_aid"/>
                                    <field name="rnv"/>
                                </group>
                                <group string="Left Eye" name="ldva_details">
                                    <field name="ldva"/>
                                    <field name="ldva_pinhole"/>
                                    <field name="ldva_aid"/>
                                    <field name="lnv"/>
                                </group>
                            </group>
                            <group name="exis_details">
                                <group name="rexis_details">
                                    <field name="rspherical"/>
                                    <field name="rcylinder"/>
                                    <field name="raxis"/>
                                    <field name="rnv_add"/>
                                </group>
                                <group name="lexis_details">
                                    <field name="lspherical"/>
                                    <field name="lcylinder"/>
                                    <field name="laxis"/>
                                    <field name="lnv_add"/>
                                </group>
                            </group>

                            <separator string="Best Corrected Visual Acuity"/>
                            <group name="bcva_details">
                                <group string="Right Eye" name="rbcva_details">
                                    <field name="rbcva_spherical"/>
                                    <field name="rbcva_cylinder"/>
                                    <field name="rbcva_axis"/>
                                    <field name="rbcva"/>
                                    <field name="rbcva_nv_add"/>
                                    <field name="rbcva_nv"/>
                                </group>
                                <group string="Left Eye" name="lbcva_details">
                                    <field name="lbcva_spherical"/>
                                    <field name="lbcva_cylinder"/>
                                    <field name="lbcva_axis"/>
                                    <field name="lbcva"/>
                                    <field name="lbcva_nv_add"/>
                                    <field name="lbcva_nv"/>
                                </group>
                            </group>
                            <group string="Tonometry" name="tonometry">
                                <field name="iop_method"/>
                            </group>
                            <group name="iop_details">
                                <group name="riop_details">
                                    <field name="riop"/>
                                </group>
                                <group name="liop_details">
                                    <field name="liop"/>
                                </group>
                            </group>
                        </page>
                        <page name="findings" string="Findings">
                            <field name="findings_ids">
                                <list string="Ophthalmology Finding" editable="bottom">
                                    <field name="affected_eye"/>
                                    <field name="eye_structure"/>
                                    <field name="finding"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pb_ophthalmology_evaluation" model="ir.actions.act_window">
        <field name="name">Ophthalmology Evaluation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.ophthalmology.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add new record.
            </p>
        </field>
    </record>


    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">hms.appointment</field>
        <field name="view_mode">list,form,kanban,calendar,pivot</field>
        <field name="domain" eval="[('department_id.department_type','=','dental')]"/>
        <field name="context">{'search_default_today': 1,'search_default_done': 1, 'pb_department_type': 'ophthalmology'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add an Ophthalmology Appointment.
            </p>
        </field>
    </record>

</odoo>