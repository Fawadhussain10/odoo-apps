<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_hms_pb_vaccination" model="ir.sequence">
            <field name="name">PB Vaccination</field>
            <field name="code">pb.vaccination</field>
            <field name="prefix">VC</field>
            <field name="padding">3</field>
            <field name="pb_auto_create" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="base.main_company" model="res.company" >
            <field name="pb_vaccination_usage_location_id" ref="stock.stock_location_customers"/>
            <field name="pb_vaccination_stock_location_id" ref="stock.stock_location_stock"/>
        </record>

    </data>
</odoo>
