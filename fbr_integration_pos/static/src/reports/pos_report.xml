<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="fbr_integration_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <t t-if="props.data">
                <div class="mt16" style="text-align: center;">
                    <strong>FBR Invoice No#</strong>
                </div>
                <div class="mt16" style="text-align: center;">
                    <strong>
                        <t t-esc="props.data.fbr_invoice_number"/>
                    </strong>
                </div>
            </t>
            <div class="mt16" style="text-align: center;">
                <t t-if="props.data.fbr_qr_image_uri">
                    <img t-att-src="'/fbr_integration_pos/static/description/images.png'"
                         style="width: 150px; height: 150px;" alt="FBR Logo"/>
                    <img t-att-src="props.data.fbr_qr_image_uri"
                         style="width: 150px; height: 150px;" alt="FBR QR Code"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
