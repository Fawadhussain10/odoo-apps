<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_res_config_settings_fbr_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.fbr</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='general_settings']/div[@id='invite_users']" position="after">
                    <div class="app_settings_block" string="FBR">
                        <block title="FBR" name="fbr_settings_block">
                            <setting id="active_user_setting">
                                <label for="fbr_mode"/>
                                <br/>
                                <field name="fbr_mode"/>
                                <br/>
                                <label for="fbr_token"/>
                                <br/>
                                <field name="fbr_token"/>
                                <br/>
                                <label for="fbr_bpos_id"/>
                                <br/>
                                <field name="fbr_bpos_id"/>
                            </setting>
                        </block>
                    </div>
                </xpath>
            </field>
        </record>

        <odoo>
            <record id="view_pos_config_form_inherit_auto_invoice" model="ir.ui.view">
                <field name="name">pos.config.form.inherit.fbr.pos</field>
                <field name="model">pos.config</field>
                <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//div[@class='oe_title']" position="after">
                        <group string="Custom POS Settings">
                            <field name="auto_invoice_on_payment"/>
                            <field name="restrict_invoice_download"/>
                            <field name="default_partner_id"/>
                        </group>
                    </xpath>
                </field>
            </record>
        </odoo>


    </data>
</odoo>
