<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template inherit_id="account.report_invoice_document" id="invoice_report_fbr_inherit">
            <!-- remove the Taxes column (located by name: stable across Odoo versions) -->
            <xpath expr="//th[@name='th_taxes']" position="replace"/>
            <xpath expr="//td[@name='td_taxes']" position="replace"/>
            <xpath expr="//th[@name='th_description']" position="after">
                <th name="th_hs_code" class="text-start">
                    <span>HS Code</span>
                </th>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']" position="after">
                <td name="account_invoice_line_hs_code">
                    <span t-if="line.pct_code" t-field="line.pct_code" t-options="{'widget': 'text'}">0000.0000</span>
                </td>
            </xpath>
            <xpath expr="//div[hasclass('invoice_main')]" position="after">
                <t t-if="o.fbr_invoice_number">
                    <div class="mt16" style="text-align: center;">
                        <strong>FBR Invoice No#</strong>
                    </div>
                    <div class="mt16" style="text-align: center;">
                        <strong>
                            <t t-out="o.fbr_invoice_number"/>
                        </strong>
                    </div>
                </t>
                <div class="mt16" style="text-align: center;">
                    <t t-if="o.fbr_qr_image">
                        <img t-att-src="'/fbr_integration_multicompany/static/description/images.png'"
                             style="width: 170px; height: 170px;" alt="FBR Logo"/>
                        <img t-att-src="image_data_uri(o.fbr_qr_image)"
                             style="width: 150px; height: 150px;" alt="FBR QR Code"/>
                    </t>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
