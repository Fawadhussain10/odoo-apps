<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_account_move_form_fbr" model="ir.ui.view">
            <field name="name">account.move.form.fbr</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[@name='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='product_id']"
                       position="after">
                    <field name="pct_code"/>
                    <field name="sale_type"/>
                    <field name="sro_schedule" optional="hide"/>
                    <field name="sro_item" optional="hide"/>
                    <field name="fed_duty" optional="hide"/>
                    <field name="further_tax" optional="hide"/>
                    <field name="extra_tax" optional="hide"/>
                    <field name="withholding_tax" optional="hide"/>
                    <field name="other_tax" optional="hide"/>
                </xpath>
                <xpath expr="//notebook/page[last()]" position="after">
                    <page name="FBR">
                        <group>
                            <group>
                                <field name="scenario_id" invisible="not display_scenario"/>
                                <field name="fbr_invoice_number" readonly="1"/>
                                <field name="fbr_post_successful" readonly="1"/>
                                <field name="fbr_qr_image" widget="image" options="{'preview_image': 'fbr_qr_image'}"
                                       style="width: 150px; height: 150px;" invisible="not qr_in_report"/>
                                <field name="qr_in_report" invisible="1"/>
                                <field name="display_scenario" invisible="1"/>
                                <field name="fbr_request" readonly="1" invisible="1"/>
                                <field name="fbr_status" readonly="1"/>
                                <field name="fbr_response" readonly="1"/>
                            </group>
                            <group/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//header/button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">qr_in_report != False</attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_post_data_to_fbr" type="object" string="Send to FBR"
                            class="oe_highlight"
                            invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or qr_in_report != False"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_search_form_fbr" model="ir.ui.view">
            <field name="name">account.move.search.fbr</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="fbr_invoice_number"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_credit_form_fbr" model="ir.ui.view">
            <field name="name">account.move.reversal.credit.form.fbr</field>
            <field name="model">account.move.reversal</field>
            <field name="inherit_id" ref="account.view_account_move_reversal"/>
            <field name="arch" type="xml">
                <xpath expr="//footer/button[@name='modify_moves']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
