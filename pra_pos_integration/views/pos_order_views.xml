<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_pra" model="ir.ui.view">
        <field name="name">pos.order.form.pra</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <button name="refund" position="after">
                <button name="action_pra_resync" string="Resync to PRA" type="object"
                        invisible="state not in ('paid', 'done', 'invoiced') or pra_status == 'synced'"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_pra_resync" type="object" class="oe_stat_button" icon="fa-refresh"
                        invisible="pra_status != 'synced'">
                    <field name="pra_invoice_number" widget="statinfo" string="PRA Invoice"/>
                </button>
            </div>
            <page name="extra" position="after">
                <page name="pra" string="PRA">
                    <group>
                        <group>
                            <field name="pra_status" readonly="1"/>
                            <field name="pra_invoice_number" readonly="1"/>
                            <field name="pra_synced_date" readonly="1"/>
                            <field name="pra_qr_image" widget="image"
                                   options="{'preview_image': 'pra_qr_image'}"
                                   style="width: 150px; height: 150px;"
                                   invisible="not pra_qr_image"/>
                        </group>
                        <group>
                            <field name="pra_request" readonly="1"/>
                            <field name="pra_response" readonly="1"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="view_pos_order_filter_pra" model="ir.ui.view">
        <field name="name">pos.order.search.pra</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <field name="pos_reference" position="after">
                <field name="pra_invoice_number"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_list_pra_logs" model="ir.ui.view">
        <field name="name">pos.order.list.pra.logs</field>
        <field name="model">pos.order</field>
        <field eval="10" name="priority"/>
        <field name="arch" type="xml">
            <list string="PRA Logs" create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="config_id"/>
                <field name="date_order"/>
                <field name="amount_total" sum="Total"/>
                <field name="pra_invoice_number"/>
                <field name="pra_status" decoration-success="pra_status == 'synced'" decoration-danger="pra_status == 'failed'"/>
                <field name="pra_synced_date"/>
                <button name="action_pra_resync" string="Resync" type="object" icon="fa-refresh"
                        invisible="pra_status == 'synced'"/>
            </list>
        </field>
    </record>

    <record id="action_pra_pos_logs" model="ir.actions.act_window">
        <field name="name">PRA Invoices</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pos_order_list_pra_logs"/>
        <field name="domain">[('config_id.pra_enabled', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No PRA-enabled orders yet.
            </p>
        </field>
    </record>

    <menuitem id="menu_pra_pos_logs"
              name="PRA Invoices"
              action="action_pra_pos_logs"
              parent="point_of_sale.menu_point_of_sale"
              sequence="25"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
