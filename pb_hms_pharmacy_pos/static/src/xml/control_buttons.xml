<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pb_hms_pharmacy_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']" position="before">
            <t t-call="point_of_sale.controlButton"
                t-if="this.pos.accessRight.canAccessQuotation"
                icon="'link'"
                btnText.translate="Prescription Order"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickPrescriptionOrder()"/>
        </xpath>
    </t>
</templates>
