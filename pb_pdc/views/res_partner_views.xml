<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pb_pdc_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.pdc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_pdc_cheques" type="object" class="oe_stat_button"
                        icon="payments" groups="account.group_account_invoice"
                        invisible="pdc_count == 0">
                    <field name="pdc_count" widget="statinfo" string="PDC Cheques"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
