<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_pb_growth_chart_data_search" model="ir.ui.view">
        <field name="name">pb.growth.chart.data.search</field>
        <field name="model">pb.growth.chart.data</field>
        <field name="arch" type="xml">
            <search string="Growth Chart Data">
                <field name="age"/>
                <field name="male_value"/>
                <field name="female_value"/>
                <field name="record_type"/>
                <newline/>
                <group>
                    <filter string="Type" name="record_type_groupby" domain="[]" context="{'group_by':'record_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pb_growth_chart_data_tree" model="ir.ui.view">
        <field name="name">pb.growth.chart.data.tree</field>
        <field name="model">pb.growth.chart.data</field>
        <field name="arch" type="xml">
            <list string="Growth Chart Data">
                <field name="record_type" invisible="1"/>
                <field name="age"/>
                <field name="male_value"/>
                <field name="female_value"/>
            </list>
        </field>
    </record>

    <record id="view_pb_pb_growth_chart_data_form" model="ir.ui.view">
        <field name="name">pb.growth.chart.data.form</field>
        <field name="model">pb.growth.chart.data</field>
        <field name="arch" type="xml">
            <form string="Growth Chart Data">
                <sheet>
                    <group>
                        <group>
                            <field name="age"/>
                            <field name="male_value"/>
                            <field name="female_value"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="record_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pb_hms_weight_chart_data" model="ir.actions.act_window">
        <field name="name">Weight Growth Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.growth.chart.data</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('record_type','=','weight')]</field>
        <field name="context">{'default_record_type': 'weight'}</field>
    </record>

    <record id="action_pb_hms_height_chart_data" model="ir.actions.act_window">
        <field name="name">Height Growth Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.growth.chart.data</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('record_type','=','height')]</field>
        <field name="context">{'default_record_type': 'height'}</field>
    </record>

    <record id="action_pb_hms_head_circum_chart_data" model="ir.actions.act_window">
        <field name="name">Head Circumference Growth Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.growth.chart.data</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('record_type','=','head_circum')]</field>
        <field name="context">{'default_record_type': 'head_circum'}</field>
    </record>

</odoo>