<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_tender_action" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">sale.tender</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create a new tender
            </p>
        </field>
    </record>

    <record id="sale_tender_view_tree" model="ir.ui.view">
        <field name="name">sale.tender.view.tree</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <list string="Tenders" decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'converted'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purpose"/>
                <field name="tender_number"/>
                <field name="mode_of_instrument"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'converted'"/>
            </list>
        </field>
    </record>

    <record id="sale_tender_view_form" model="ir.ui.view">
        <field name="name">sale.tender.view.form</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <header>
                    <button name="action_accept" string="Accept" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="sale_tender.sale_tender_group_approver"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'draft'"
                            groups="sale_tender.sale_tender_group_approver"/>
                    <button name="action_convert_to_quotation" string="Convert to Quotation"
                            type="object" class="oe_highlight"
                            invisible="state != 'accepted'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('accepted', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,accepted,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotation" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Quotation"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   options="{'always_reload': True}"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="mode_of_instrument" readonly="state != 'draft'"/>
                            <field name="tender_number" readonly="state != 'draft'"/>
                            <field name="tender_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="currency_id" invisible="1"/>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom" groups="uom.group_uom" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id" widget="many2many_tags"/>
                                    <field name="price_subtotal" sum="Subtotal"/>
                                    <field name="price_total" sum="Total" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="attachment_type"/>
                                    <field name="name"/>
                                    <field name="datas" filename="filename" widget="binary"/>
                                    <field name="filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sale_tender_view_search" model="ir.ui.view">
        <field name="name">sale.tender.view.search</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <search string="Tenders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="tender_number"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Accepted" name="filter_accepted" domain="[('state', '=', 'accepted')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Converted" name="filter_converted" domain="[('state', '=', 'converted')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Purpose" name="group_purpose" context="{'group_by': 'purpose'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
