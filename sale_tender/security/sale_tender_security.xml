<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sale_tender" model="ir.module.category">
        <field name="name">Tenders</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_sale_tender" model="res.groups.privilege">
        <field name="name">Tenders</field>
        <field name="category_id" ref="module_category_sale_tender"/>
    </record>

    <record id="sale_tender_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_sale_tender"/>
        <field name="comment">Can access the Tenders app: create tenders and convert
            accepted tenders into quotations.</field>
    </record>

    <record id="sale_tender_group_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_sale_tender"/>
        <field name="implied_ids" eval="[(4, ref('sale_tender_group_user'))]"/>
        <field name="comment">Can Accept or Reject tenders submitted for internal
            approval.</field>
    </record>
</odoo>
