<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="li_service_view_list" model="ir.ui.view">
        <field name="name">li.service.list</field>
        <field name="model">li.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="value_points" optional="show"/>
                <field name="crm_team_id"/>
                <field name="crm_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="li_service_view_form" model="ir.ui.view">
        <field name="name">li.service.form</field>
        <field name="model">li.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Odoo"/></h1></div>
                    <group>
                        <field name="description" placeholder="Short pitch the AI uses — written as sales copy"/>
                        <field name="value_points" placeholder="Proof points / case studies"/>
                        <field name="crm_team_id"/>
                        <field name="crm_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="active"/>
                    </group>
                    <group string="Contact details for prospects">
                        <div colspan="2" class="text-muted mb-2">Claude gives these only when the prospect asks for our phone number or email address. Leave empty and Claude says a colleague will share them.</div>
                        <field name="contact_phone" widget="phone"/>
                        <field name="contact_email" widget="email"/>
                    </group>
                    <group string="Portfolio">
                        <div colspan="2" class="text-muted mb-2">Claude adds the portfolio link to a message when the prospect asks for a portfolio, examples or past work, or when it clearly helps. LinkedIn messages are text only, so the file goes out as a link.</div>
                        <field name="portfolio_filename" invisible="1"/>
                        <field name="portfolio_file" filename="portfolio_filename"/>
                        <field name="portfolio_url" widget="url" placeholder="https://… (optional, used instead of the file)"/>
                        <field name="portfolio_link" widget="CopyClipboardChar" invisible="not portfolio_link"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_li_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">li.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the services you sell</p>
            <p>Odoo, Bookkeeping, Advisory… The description and value points are fed to Claude.</p>
        </field>
    </record>
</odoo>
