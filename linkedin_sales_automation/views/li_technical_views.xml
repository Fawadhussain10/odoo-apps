<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="li_work_item_view_list" model="ir.ui.view">
        <field name="name">li.work.item.list</field>
        <field name="model">li.work.item</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state in ('expired', 'cancelled')" decoration-danger="state == 'failed'">
                <field name="id" string="Work ID"/>
                <field name="date_released"/>
                <field name="work_type"/>
                <field name="state" widget="badge"/>
                <field name="agent_type"/>
                <field name="linkedin_profile_id"/>
                <field name="persona_id"/>
                <field name="prospect_id"/>
                <field name="quota_date" optional="hide"/>
                <field name="quota_consumed" optional="hide"/>
                <field name="confirmed" optional="hide"/>
                <field name="text_confirmed" string="Approved text" optional="show"/>
                <field name="result_status"/>
                <field name="discarded_stale" optional="hide"/>
                <field name="cancel_reason" optional="hide"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="li_work_item_view_form" model="ir.ui.view">
        <field name="name">li.work.item.form</field>
        <field name="model">li.work.item</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="id" string="Work ID"/>
                            <field name="work_type"/>
                            <field name="state"/>
                            <field name="agent_type"/>
                            <field name="linkedin_profile_id"/>
                            <field name="persona_id"/>
                            <field name="prospect_id"/>
                            <field name="step_id"/>
                            <field name="followup_step_id"/>
                        </group>
                        <group>
                            <field name="date_released"/>
                            <field name="expires_at"/>
                            <field name="date_confirmed"/>
                            <field name="date_done"/>
                            <field name="quota_date"/>
                            <field name="quota_consumed"/>
                            <field name="result_status"/>
                            <field name="retry_safe"/>
                            <field name="cancel_reason"/>
                            <field name="conversation_version"/>
                            <field name="discarded_stale"/>
                            <field name="send_attempts"/>
                        </group>
                    </group>
                    <group>
                        <field name="text_confirmed" string="Approved text"/>
                        <field name="text_sent"/>
                        <field name="error"/>
                        <field name="payload" class="font-monospace"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="li_work_item_view_search" model="ir.ui.view">
        <field name="name">li.work.item.search</field>
        <field name="model">li.work.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="persona_id"/>
                <field name="prospect_id"/>
                <field name="linkedin_profile_id"/>
                <filter name="released" string="Released" domain="[('state', '=', 'released')]"/>
                <filter name="queued" string="Sending queue" domain="[('state', 'in', ('queued', 'sending'))]"/>
                <filter name="stale" string="Discarded (stale)" domain="[('discarded_stale', '=', True)]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'work_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_li_work_item" model="ir.actions.act_window">
        <field name="name">Work items</field>
        <field name="res_model">li.work.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="li_engine_action_view_list" model="ir.ui.view">
        <field name="name">li.engine.action.list</field>
        <field name="model">li.engine.action</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="state == 'error'">
                <field name="date"/>
                <field name="linkedin_profile_id"/>
                <field name="action"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'error'"/>
                <field name="status"/>
                <field name="reads" sum="Pages read"/>
                <field name="duration_ms"/>
                <field name="prospect_id"/>
                <field name="persona_id" optional="hide"/>
                <field name="detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="li_engine_action_view_form" model="ir.ui.view">
        <field name="name">li.engine.action.form</field>
        <field name="model">li.engine.action</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="linkedin_profile_id"/>
                            <field name="action"/>
                            <field name="state"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="reads"/>
                            <field name="duration_ms"/>
                            <field name="work_item_id"/>
                            <field name="prospect_id"/>
                            <field name="persona_id"/>
                        </group>
                    </group>
                    <field name="detail" class="font-monospace small"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="li_engine_action_view_search" model="ir.ui.view">
        <field name="name">li.engine.action.search</field>
        <field name="model">li.engine.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="linkedin_profile_id"/>
                <field name="prospect_id"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <filter name="sends" string="Sends" domain="[('action', 'in', ('invite', 'message', 'followup', 'handoff'))]"/>
                <filter name="today" string="Last 24 hours"
                        domain="[('date', '&gt;', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_profile" string="LinkedIn Profile" context="{'group_by': 'linkedin_profile_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_li_engine_action" model="ir.actions.act_window">
        <field name="name">Engine actions</field>
        <field name="res_model">li.engine.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="li_mcp_log_view_list" model="ir.ui.view">
        <field name="name">li.mcp.log.list</field>
        <field name="model">li.mcp.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="not ok">
                <field name="date"/>
                <field name="user_id"/>
                <field name="method"/>
                <field name="tool"/>
                <field name="args_size"/>
                <field name="duration_ms"/>
                <field name="ok"/>
                <field name="error"/>
                <field name="remote_addr" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_li_mcp_log" model="ir.actions.act_window">
        <field name="name">MCP call log</field>
        <field name="res_model">li.mcp.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
