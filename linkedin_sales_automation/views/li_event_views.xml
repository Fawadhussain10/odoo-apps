<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="li_event_view_list" model="ir.ui.view">
        <field name="name">li.event.list</field>
        <field name="model">li.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-success="event_type in ('warm_lead', 'meeting_booked')"
                  decoration-danger="event_type in ('error', 'reply_activity_overdue')">
                <field name="date"/>
                <field name="event_type"/>
                <field name="agent_type"/>
                <field name="persona_id"/>
                <field name="linkedin_profile_id" optional="hide"/>
                <field name="service_id" optional="hide"/>
                <field name="prospect_id"/>
                <field name="crm_lead_id" optional="show"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="li_event_view_form" model="ir.ui.view">
        <field name="name">li.event.form</field>
        <field name="model">li.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="event_type"/>
                            <field name="agent_type"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="persona_id"/>
                            <field name="linkedin_profile_id"/>
                            <field name="service_id"/>
                            <field name="prospect_id"/>
                            <field name="crm_lead_id"/>
                        </group>
                    </group>
                    <field name="detail"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="li_event_view_pivot" model="ir.ui.view">
        <field name="name">li.event.pivot</field>
        <field name="model">li.event</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="persona_id" type="row"/>
                <field name="event_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="li_event_view_graph" model="ir.ui.view">
        <field name="name">li.event.graph</field>
        <field name="model">li.event</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="date" interval="day"/>
                <field name="event_type"/>
            </graph>
        </field>
    </record>

    <record id="li_event_view_search" model="ir.ui.view">
        <field name="name">li.event.search</field>
        <field name="model">li.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="persona_id"/>
                <field name="prospect_id"/>
                <field name="linkedin_profile_id"/>
                <field name="detail"/>
                <filter name="invites" string="Invites" domain="[('event_type', 'in', ('invite_sent', 'invite_accepted', 'invite_withdrawn'))]"/>
                <filter name="messages" string="Messages" domain="[('event_type', 'in', ('message_sent', 'reply_received', 'followup_sent'))]"/>
                <filter name="leads" string="Leads" domain="[('event_type', 'in', ('warm_lead', 'meeting_booked', 'taken_over'))]"/>
                <filter name="errors" string="Errors" domain="[('event_type', '=', 'error')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Event type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_type'}"/>
                    <filter name="group_persona" string="Persona" context="{'group_by': 'persona_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_li_event" model="ir.actions.act_window">
        <field name="name">Agent activity log</field>
        <field name="res_model">li.event</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>
</odoo>
