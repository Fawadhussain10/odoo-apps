<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Blood Requisition -->
    <record id="pb_pb_blood_requisition_form" model="ir.ui.view">
        <field name="name">pb.blood.requisition.form</field>
        <field name="model">pb.blood.requisition</field>
        <field name="arch" type="xml">
            <form string="Blood Management">
                <header>
                    <button name="action_running" invisible="state not in ('draft',)" class="oe_highlight" string="Running" type="object"/>
                    <button name="action_done" invisible="state not in ('running',)" class="oe_highlight" string="Done" type="object"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" invisible="state not in ('to_invoice',)" class="oe_highlight" groups="account.group_account_invoice"/>
                    <button name="view_invoice" string="View Invoice" type="object" invisible="not invoice_id" class="oe_highlight" groups="account.group_account_invoice"/>
                    <button name="action_cancel" invisible="state not in ('draft',)" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done" statusbar_colors="{&quot;draft&quot;:&quot;blue&quot;,&quot;cancel&quot;:&quot;red&quot;}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group colspan="2">
                        <group>
                            <field name="partner_id" readonly="(patient_id or state in ('done', 'cancel', 'to_invoice'))" force_save="1"/>
                            <field name="patient_id"/>
                            <field name="blood_group"/>
                            <field name="product_id"/>
                            <field name="lot_id" context="{'pb_product_id': product_id}" domain="[('requisition_id', '=', False),('issuance_id','=',False), ('product_id','=',product_id)]"/>
                            <field name="invoice_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="physician_id"/>
                            <field name="date"/>
                            <field name="is_outside"/>
                            <field name="location" invisible="not is_outside" required="is_outside"/>
                            <field name="department_id" groups="pb_hms.group_allow_multi_department"/>
                        </group>
                    </group>
                    <field name="remark" nolabel="1" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pb_pb_blood_requisition_tree" model="ir.ui.view">
        <field name="name">pb.blood.requisition.tree</field>
        <field name="model">pb.blood.requisition</field>
        <field name="arch" type="xml">
            <list string="Blood Requisition">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="pb_pb_blood_requisition_calendar" model="ir.ui.view">
        <field name="name">pb.blood.requisition.calendar</field>
        <field name="model">pb.blood.requisition</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar string="Blood Requisition" color="physician_id" date_start="date">
                <field name="physician_id"/>
                <field name="user_id"/>
                <field name="patient_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="pb_pb_blood_requisition_pivot" model="ir.ui.view">
        <field name="name">pb.blood.requisition.pivot</field>
        <field name="model">pb.blood.requisition</field>
        <field name="arch" type="xml">
            <pivot string="Blood Requisition">
                <field name="date" type="row"/>
                <field name="physician_id" type="row"/>
                <field name="user_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="pb_pb_blood_requisition_search" model="ir.ui.view">
        <field name="name">pb.blood.requisition.search</field>
        <field name="model">pb.blood.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="location"/>
                <filter name="is_outside" string="Outside Requisition" domain="[('is_outside', '=',1)]"/>
                <group>
                    <filter string="Contact" name="partner_groupby" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Patient" name="patient_groupby" domain="[]" context="{'group_by':'patient_id'}"/>
                    <filter string="Physician" name="physician_groupby" domain="[]" context="{'group_by':'physician_id'}"/>
                    <filter string="Responsible" name="responsible_groupby" domain="[]" context="{'group_by':'user_id'}"/>
                    <filter string="Hospital" name="hospital_groupby" domain="[]" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_blood_requisition" model="ir.actions.act_window">
        <field name="name">Blood Requisition</field>
        <field name="res_model">pb.blood.requisition</field>
        <field name="view_mode">list,form,calendar,pivot,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to add a Blood Requisition.
            </p>
        </field>
    </record>

    <!-- Issuance Views -->
    <record id="view_pb_blood_issuance_tree" model="ir.ui.view">
        <field name="name">pb.blood.issuance.tree</field>
        <field name="model">pb.blood.issuance</field>
        <field name="arch" type="xml">
            <list string="Blood Receiver">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pb_blood_issuance_form" model="ir.ui.view">
        <field name="name">pb.blood.issuance.form</field>
        <field name="model">pb.blood.issuance</field>
        <field name="arch" type="xml">
            <form string="Blood Receiver">
                <header>
                    <button name="action_done" invisible="state not in ('draft',)" class="oe_highlight" string="Issue" type="object"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" invisible="state not in ('to_invoice',)" class="oe_highlight" groups="account.group_account_invoice"/>
                    <button name="view_invoice" string="View Invoice" type="object" invisible="not invoice_id" class="oe_highlight" groups="account.group_account_invoice"/>
                    <button name="action_cancel" invisible="state not in ('draft',)" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done" statusbar_colors="{&quot;draft&quot;:&quot;blue&quot;,&quot;cancel&quot;:&quot;red&quot;}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group colspan="2">
                        <group>
                            <field name="partner_id" readonly="(patient_id or state in ('done', 'cancel', 'to_invoice'))" force_save="1"/>
                            <field name="patient_id"/>
                            <field name="blood_group"/>
                            <field name="product_id"/>
                            <field name="lot_id" context="{'pb_product_id': product_id}" domain="[('blood_group','=',blood_group),('requisition_id', '!=', False),('issuance_id','=',False), ('product_id','=',product_id)]"/>
                            <field name="invoice_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="physician_id"/>
                            <field name="date"/>
                            <field name="is_outside"/>
                            <field name="location" invisible="not is_outside" required="is_outside"/>
                            <field name="department_id" groups="pb_hms.group_allow_multi_department"/>
                        </group>
                    </group>
                    <field name="remark" nolabel="1" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pb_pb_blood_issuance_calendar" model="ir.ui.view">
        <field name="name">pb.blood.issuance.calendar</field>
        <field name="model">pb.blood.issuance</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar string="Blood Requisition" color="physician_id" date_start="date">
                <field name="physician_id"/>
                <field name="user_id"/>
                <field name="patient_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="pb_pb_blood_issuance_pivot" model="ir.ui.view">
        <field name="name">pb.blood.issuance.pivot</field>
        <field name="model">pb.blood.issuance</field>
        <field name="arch" type="xml">
            <pivot string="Blood Requisition">
                <field name="date" type="row"/>
                <field name="physician_id" type="row"/>
                <field name="user_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="pb_pb_blood_issuance_search" model="ir.ui.view">
        <field name="name">pb.blood.issuance.search</field>
        <field name="model">pb.blood.issuance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="location"/>
                <filter name="is_outside" string="Outside Requisition" domain="[('is_outside', '=',1)]"/>
                <group>
                    <filter string="Contact" name="partner_groupby" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Patient" name="patient_groupby" domain="[]" context="{'group_by':'patient_id'}"/>
                    <filter string="Physician" name="physician_groupby" domain="[]" context="{'group_by':'physician_id'}"/>
                    <filter string="Responsible" name="responsible_groupby" domain="[]" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_blood_issuance" model="ir.actions.act_window">
        <field name="name">Blood Issuance</field>
        <field name="res_model">pb.blood.issuance</field>
        <field name="view_mode">list,form,calendar,pivot,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to add a Blood Issuance.
            </p>
        </field>
    </record>

</odoo>