<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hrw" model="ir.module.category">
        <field name="name">HR Process Workflows</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_hrw_requester" model="res.groups">
        <field name="name">Requester / Hiring Manager</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_hrw_legal" model="res.groups">
        <field name="name">Legal</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="group_hrw_finance" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="group_hrw_group_finance" model="res.groups">
        <field name="name">Group Finance Manager</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="group_hrw_hr_ops" model="res.groups">
        <field name="name">HR Operations</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester')), (4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_hrw_payroll" model="res.groups">
        <field name="name">Payroll</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester')), (4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_hrw_hr_director" model="res.groups">
        <field name="name">HR Director</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_hr_ops'))]"/>
    </record>
    <record id="group_hrw_gm" model="res.groups">
        <field name="name">General Manager</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="group_hrw_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="group_hrw_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_hrw"/>
        <field name="implied_ids" eval="[(4, ref('group_hrw_hr_director')), (4, ref('group_hrw_payroll')), (4, ref('hr_contract.group_hr_contract_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- record rules -->
    <record id="rule_hrw_request_company" model="ir.rule">
        <field name="name">HR Request: multi-company</field>
        <field name="model_id" ref="model_hr_workflow_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hrw_request_involved" model="ir.rule">
        <field name="name">HR Request: own or involved</field>
        <field name="model_id" ref="model_hr_workflow_request"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('approval_ids.approver_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_hrw_requester'))]"/>
    </record>
    <record id="rule_hrw_request_all" model="ir.rule">
        <field name="name">HR Request: all</field>
        <field name="model_id" ref="model_hr_workflow_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hrw_hr_ops')), (4, ref('group_hrw_payroll')), (4, ref('group_hrw_gm')), (4, ref('group_hrw_ceo'))]"/>
    </record>
</odoo>
