<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ form -->
    <record id="view_hrw_request_form" model="ir.ui.view">
        <field name="name">hr.workflow.request.form</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <form string="HR Request">
                <field name="can_approve" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="contract_id" invisible="1"/>
                <field name="current_step_category" invisible="1"/>
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success"
                            invisible="not can_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" class="btn-danger"
                            invisible="not can_approve"/>
                    <button name="action_compute_settlement" type="object" string="Compute Settlement"
                            invisible="request_type not in ('resignation', 'termination') or state not in ('draft', 'in_approval', 'approved')"
                            groups="hr_process_workflow.group_hrw_hr_ops,hr_process_workflow.group_hrw_finance"/>
                    <button name="action_create_employee" type="object" string="Create Employee" class="btn-primary"
                            invisible="request_type != 'new_hire' or state != 'approved'"
                            groups="hr_process_workflow.group_hrw_hr_ops"/>
                    <button name="action_apply" type="object" string="Apply Now" class="btn-primary"
                            invisible="request_type == 'new_hire' or state != 'approved'"
                            groups="hr_process_workflow.group_hrw_hr_ops,hr_process_workflow.group_hrw_payroll"/>
                    <button name="action_print" type="object" string="Print"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'in_approval', 'approved')"
                            confirm="Cancel this request?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employee" type="object" class="oe_stat_button" icon="fa-user"
                                invisible="not employee_id">
                            <div class="o_stat_info"><span class="o_stat_text">Employee</span></div>
                        </button>
                        <button name="action_open_contract" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not contract_id" groups="hr_contract.group_hr_contract_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Contract</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Applied" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <field name="is_overdue" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3 invisible="state != 'in_approval'" class="text-muted">
                            Pending: <field name="current_step_name" class="text-primary"/>
                            (<field name="current_approver_ids" widget="many2many_tags_avatar" class="d-inline-flex"/>)
                            due <field name="current_deadline"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="request_type" readonly="state != 'draft'" widget="radio"/>
                            <field name="employee_id" invisible="request_type == 'new_hire'"
                                   required="request_type != 'new_hire'" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="new_employee_name" invisible="request_type != 'new_hire'"
                                   required="request_type == 'new_hire'" readonly="state != 'draft'"/>
                            <field name="new_employee_name_ar" invisible="request_type != 'new_hire'"
                                   readonly="state != 'draft'" class="text-end" dir="rtl"/>
                            <field name="employee_code" readonly="state != 'draft' or request_type != 'new_hire'"/>
                            <field name="company_id" readonly="state != 'draft' or request_type != 'new_hire'"
                                   groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="effective_date" string="Joining Date" invisible="request_type != 'new_hire'"
                                   readonly="state != 'draft'"/>
                            <field name="effective_date" string="Last Working Day"
                                   invisible="request_type not in ('resignation', 'termination')"
                                   readonly="state not in ('draft', 'in_approval')"/>
                            <field name="effective_date" string="Effective Date" invisible="request_type != 'change'"
                                   readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="change_summary" invisible="request_type != 'change'"/>
                            <label for="progress" string="Approval Progress" invisible="state == 'draft'"/>
                            <field name="progress" widget="progressbar" nolabel="1" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- ===================== new hire particulars -->
                        <page string="Employee Particulars" name="particulars" invisible="request_type != 'new_hire'">
                            <group>
                                <group string="Identity">
                                    <field name="nationality_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="identification_id" readonly="state != 'draft'"/>
                                    <field name="passport_id" readonly="state != 'draft'"/>
                                    <field name="gender" readonly="state != 'draft'"/>
                                    <field name="birthday" readonly="state != 'draft'"/>
                                </group>
                                <group string="Contact &amp; Bank">
                                    <field name="work_email" widget="email" readonly="state != 'draft'"/>
                                    <field name="mobile_phone" widget="phone" readonly="state != 'draft'"/>
                                    <field name="bank_id" readonly="state != 'draft'"/>
                                    <field name="bank_acc_number" readonly="state != 'draft'"/>
                                </group>
                                <group string="Position">
                                    <field name="new_business_unit_id" string="Business Unit" readonly="state != 'draft'"/>
                                    <field name="new_department_id" string="Department" readonly="state != 'draft'"/>
                                    <field name="new_job_id" string="Job Position" readonly="state != 'draft'"/>
                                    <field name="new_job_title" string="Job Title" readonly="state != 'draft'"/>
                                    <field name="new_grade_id" string="Grade" readonly="state != 'draft'"/>
                                    <field name="new_manager_id" string="Reporting Manager" readonly="state != 'draft'"/>
                                    <field name="new_cost_center_id" string="Cost Center" readonly="state != 'draft'"/>
                                </group>
                                <group string="Contract">
                                    <field name="contract_type_id" readonly="state != 'draft'"/>
                                    <field name="contract_end_date" readonly="state != 'draft'"/>
                                    <field name="position_approved" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group string="HR Operations Validation" groups="hr_process_workflow.group_hrw_hr_ops">
                                <group>
                                    <field name="docs_validated" readonly="state != 'in_approval'"/>
                                    <field name="position_validated" readonly="state != 'in_approval'"/>
                                </group>
                                <group>
                                    <field name="contract_validated" readonly="state != 'in_approval'"/>
                                    <field name="eligibility_validated" readonly="state != 'in_approval'"/>
                                </group>
                            </group>
                            <separator string="Statutory Registrations"/>
                            <field name="statutory_line_ids" readonly="state not in ('draft', 'in_approval')">
                                <tree editable="bottom">
                                    <field name="type_id"/>
                                    <field name="reference"/>
                                    <field name="status" widget="badge" decoration-success="status == 'registered'"
                                           decoration-warning="status in ('pending', 'in_progress')"
                                           decoration-danger="status == 'expired'"/>
                                    <field name="date"/>
                                    <field name="expiry_date"/>
                                </tree>
                            </field>
                        </page>

                        <!-- ===================== current / proposed position -->
                        <page string="Position &amp; Organisation" name="position" invisible="request_type == 'new_hire'">
                            <group>
                                <group string="Current">
                                    <field name="business_unit_id" readonly="1"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="job_id" readonly="1"/>
                                    <field name="job_title" readonly="1"/>
                                    <field name="manager_id" readonly="1"/>
                                    <field name="grade_id" readonly="1"/>
                                    <field name="cost_center_id" readonly="1"/>
                                </group>
                                <group string="Proposed" invisible="request_type != 'change'">
                                    <field name="new_company_id" readonly="state != 'draft'" groups="base.group_multi_company"
                                           options="{'no_create': True}"/>
                                    <field name="new_business_unit_id" readonly="state != 'draft'"/>
                                    <field name="new_department_id" readonly="state != 'draft'"/>
                                    <field name="new_job_id" readonly="state != 'draft'"/>
                                    <field name="new_job_title" readonly="state != 'draft'"/>
                                    <field name="new_manager_id" readonly="state != 'draft'"/>
                                    <field name="new_grade_id" readonly="state != 'draft'"/>
                                    <field name="new_cost_center_id" readonly="state != 'draft'"/>
                                </group>
                                <group string="Exit Details" invisible="request_type not in ('resignation', 'termination')">
                                    <field name="departure_reason_id" readonly="state not in ('draft', 'in_approval')"/>
                                    <field name="notice_date" readonly="state != 'draft'"
                                           required="request_type == 'resignation'"/>
                                    <field name="notice_period_days" readonly="state not in ('draft', 'in_approval')"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===================== salary -->
                        <page string="Salary Components" name="salary">
                            <field name="salary_line_ids" readonly="state != 'draft' or request_type in ('resignation', 'termination')">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="component_id" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="old_amount" readonly="1" force_save="1"
                                           column_invisible="parent.request_type == 'new_hire'" sum="Total"/>
                                    <field name="new_amount" sum="Total"
                                           column_invisible="parent.request_type in ('resignation', 'termination')"/>
                                    <field name="difference" sum="Total" column_invisible="parent.request_type != 'change'"
                                           decoration-success="difference &gt; 0" decoration-danger="difference &lt; 0"/>
                                    <field name="difference_pct" widget="percentage_text" column_invisible="parent.request_type != 'change'"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer" invisible="request_type != 'change'">
                                <field name="old_total"/>
                                <field name="new_total"/>
                                <field name="total_difference"/>
                                <field name="total_difference_pct" string="Difference %"/>
                            </group>
                            <group invisible="request_type != 'change'" string="Budget &amp; Amendment">
                                <group>
                                    <field name="budget_approved" readonly="state not in ('draft', 'in_approval')"/>
                                    <field name="budget_reference" readonly="state not in ('draft', 'in_approval')"/>
                                </group>
                                <group>
                                    <field name="signed_amendment_name" invisible="1"/>
                                    <field name="signed_amendment" filename="signed_amendment_name"
                                           readonly="state in ('done', 'cancel', 'rejected')"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===================== settlement -->
                        <page string="Final Settlement" name="settlement"
                              invisible="request_type not in ('resignation', 'termination')">
                            <field name="settlement_line_ids" readonly="state in ('done', 'cancel', 'rejected')">
                                <tree editable="bottom" decoration-danger="line_type == 'deduction'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                    <field name="auto" widget="boolean_toggle" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="settlement_earnings" string="Earnings"/>
                                <field name="settlement_deductions" string="Deductions"/>
                                <field name="settlement_net" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <!-- ===================== reason / legal -->
                        <page string="Reason &amp; Notes" name="reason">
                            <group>
                                <field name="reason" readonly="state != 'draft'" placeholder="Reason / justification..."/>
                                <field name="legal_opinion" invisible="request_type != 'termination'"
                                       readonly="state != 'in_approval'"
                                       groups="hr_process_workflow.group_hrw_legal,hr_process_workflow.group_hrw_hr_ops"/>
                            </group>
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>

                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   readonly="state in ('done', 'cancel')"/>
                        </page>

                        <page string="Approval History" name="approvals" invisible="state == 'draft' and not approval_ids">
                            <field name="approval_ids" readonly="1">
                                <tree decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"
                                      decoration-muted="state == 'skipped'" decoration-info="state == 'pending'">
                                    <field name="round" string="Round"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="approver_ids" widget="many2many_tags_avatar"/>
                                    <field name="activated_date"/>
                                    <field name="deadline"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'" decoration-info="state == 'pending'"/>
                                    <field name="decided_by" widget="many2one_avatar_user"/>
                                    <field name="decided_date"/>
                                    <field name="response_hours" string="Hours"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                            <group>
                                <group>
                                    <field name="submit_date"/>
                                    <field name="approved_date"/>
                                </group>
                                <group>
                                    <field name="done_date"/>
                                    <field name="cycle_days"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================ tree -->
    <record id="view_hrw_request_tree" model="ir.ui.view">
        <field name="name">hr.workflow.request.tree</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue" decoration-muted="state in ('cancel', 'rejected')"
                  sample="1">
                <field name="is_overdue" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="request_type" widget="badge"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="new_employee_name" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="request_date"/>
                <field name="effective_date"/>
                <field name="current_step_name"/>
                <field name="current_approver_ids" widget="many2many_tags_avatar" optional="show"/>
                <field name="current_deadline" optional="show"/>
                <field name="cost_impact" sum="Total" optional="hide"/>
                <field name="cycle_days" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'in_approval'"
                       decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================ kanban -->
    <record id="view_hrw_request_kanban" model="ir.ui.view">
        <field name="name">hr.workflow.request.kanban</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1" quick_create="false"
                    group_create="false" group_delete="false" records_draggable="false">
                <field name="state"/>
                <field name="is_overdue"/>
                <progressbar field="request_type"
                             colors='{"new_hire": "success", "resignation": "warning", "termination": "danger", "change": "info"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger">Overdue</span>
                            </div>
                            <div><field name="request_type" widget="badge"/></div>
                            <div class="mt-1">
                                <field name="employee_id"/><field name="new_employee_name"/>
                            </div>
                            <div class="text-muted small"><field name="current_step_name"/></div>
                            <div class="oe_kanban_bottom_left mt-1"><field name="effective_date"/></div>
                            <div class="oe_kanban_bottom_right">
                                <field name="current_approver_ids" widget="many2many_avatar_user"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================ search -->
    <record id="view_hrw_request_search" model="ir.ui.view">
        <field name="name">hr.workflow.request.search</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="new_employee_name"/>
                <field name="department_id"/>
                <field name="business_unit_id"/>
                <field name="current_approver_ids" string="Approver"/>
                <filter name="to_approve" string="To Approve (me)" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="my_requests" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'in_approval', 'approved'))]"/>
                <filter name="in_approval" string="In Approval" domain="[('state', '=', 'in_approval')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="legal" string="Pending Legal Review"
                        domain="[('state', '=', 'in_approval'), ('current_step_category', '=', 'legal')]"/>
                <filter name="to_apply" string="Approved - to Apply" domain="[('state', '=', 'approved')]"/>
                <filter name="done" string="Applied" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="new_hire" string="New Hires" domain="[('request_type', '=', 'new_hire')]"/>
                <filter name="exits" string="Exits" domain="[('request_type', 'in', ('resignation', 'termination'))]"/>
                <filter name="changes" string="Salary / Position Changes" domain="[('request_type', '=', 'change')]"/>
                <separator/>
                <filter name="request_date" string="Request Date" date="request_date"/>
                <filter name="effective_date" string="Effective Date" date="effective_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Transaction Type" context="{'group_by': 'request_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Legal Entity" context="{'group_by': 'company_id'}"/>
                    <filter name="group_bu" string="Business Unit" context="{'group_by': 'business_unit_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_step" string="Current Step" context="{'group_by': 'current_step_name'}"/>
                    <filter name="group_month" string="Request Month" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hrw_request_pivot" model="ir.ui.view">
        <field name="name">hr.workflow.request.pivot</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="request_type" type="row"/>
                <field name="state" type="col"/>
                <field name="cost_impact" type="measure"/>
                <field name="cycle_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hrw_request_graph" model="ir.ui.view">
        <field name="name">hr.workflow.request.graph</field>
        <field name="model">hr.workflow.request</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="request_date" interval="month"/>
                <field name="request_type"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================ actions -->
    <record id="action_hrw_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first HR request</p>
            <p>New hires, resignations, terminations and salary / position changes go through the approval matrix.</p>
        </field>
    </record>
    <record id="action_hrw_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p></field>
    </record>
    <record id="action_hrw_request_new_hire" model="ir.actions.act_window">
        <field name="name">New Hires</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('request_type', '=', 'new_hire')]</field>
        <field name="context">{'default_request_type': 'new_hire'}</field>
    </record>
    <record id="action_hrw_request_resignation" model="ir.actions.act_window">
        <field name="name">Resignations</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('request_type', '=', 'resignation')]</field>
        <field name="context">{'default_request_type': 'resignation'}</field>
    </record>
    <record id="action_hrw_request_termination" model="ir.actions.act_window">
        <field name="name">Terminations</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('request_type', '=', 'termination')]</field>
        <field name="context">{'default_request_type': 'termination'}</field>
    </record>
    <record id="action_hrw_request_change" model="ir.actions.act_window">
        <field name="name">Salary / Position Changes</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('request_type', '=', 'change')]</field>
        <field name="context">{'default_request_type': 'change'}</field>
    </record>
    <record id="action_hrw_request_analysis" model="ir.actions.act_window">
        <field name="name">Request Analysis</field>
        <field name="res_model">hr.workflow.request</field>
        <field name="view_mode">pivot,graph,tree</field>
    </record>
</odoo>
