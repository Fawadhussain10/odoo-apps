<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_hrw_apply_due" model="ir.cron">
        <field name="name">HR Workflows: apply approved requests on effective date</field>
        <field name="model_id" ref="model_hr_workflow_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_due_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
