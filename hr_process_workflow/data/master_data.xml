<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="component_basic" model="hr.salary.component">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="contract_field_id" ref="hr_contract.field_hr_contract__wage"/>
    </record>
    <record id="component_housing" model="hr.salary.component">
        <field name="name">Housing Allowance</field>
        <field name="code">HOUSING</field>
        <field name="sequence">10</field>
    </record>
    <record id="component_transport" model="hr.salary.component">
        <field name="name">Transportation Allowance</field>
        <field name="code">TRANSPORT</field>
        <field name="sequence">20</field>
    </record>
    <record id="component_other" model="hr.salary.component">
        <field name="name">Other Allowance</field>
        <field name="code">OTHER</field>
        <field name="sequence">30</field>
    </record>

    <record id="statutory_social_insurance" model="hr.statutory.type">
        <field name="name">Social Insurance</field><field name="code">SI</field><field name="sequence">1</field>
    </record>
    <record id="statutory_work_permit" model="hr.statutory.type">
        <field name="name">Work Permit / Labour Card</field><field name="code">WP</field><field name="sequence">2</field>
    </record>
    <record id="statutory_residence" model="hr.statutory.type">
        <field name="name">Residence Permit / Visa</field><field name="code">RP</field><field name="sequence">3</field>
    </record>
    <record id="statutory_medical" model="hr.statutory.type">
        <field name="name">Medical Insurance</field><field name="code">MED</field><field name="sequence">4</field>
    </record>
    <record id="statutory_wps" model="hr.statutory.type">
        <field name="name">Wage Protection (WPS)</field><field name="code">WPS</field><field name="sequence">5</field>
    </record>
</odoo>
