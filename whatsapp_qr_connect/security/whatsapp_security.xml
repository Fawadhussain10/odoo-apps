<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">55</field>
    </record>

    <record id="res_groups_privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="category_id" ref="module_category_whatsapp"/>
    </record>

    <record id="group_whatsapp_chat" model="res.groups">
        <field name="name">Chat User</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="comment">Can see the WhatsApp app on the home screen: read and answer the
            chats Odoo started and receive the new-message pop-up. Sending documents from the
            WhatsApp buttons does not need this group.</field>
    </record>

    <!-- administrators get it automatically -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('whatsapp_qr_connect.group_whatsapp_chat'))]"/>
    </record>
</odoo>
