<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_whatsapp_message_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-danger="status in ('ERROR', 'NOT_LINKED')"
                  decoration-warning="status in ('NOT_WHATSAPP', 'INVALID_PHONE')">
                <field name="date"/>
                <field name="account_id"/>
                <field name="phone"/>
                <field name="body"/>
                <field name="attachment_name" optional="show"/>
                <field name="status" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="account_id"/>
                            <field name="phone"/>
                            <field name="attachment_name"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="message_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <field name="detail" invisible="not detail"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_message_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="body"/>
                <field name="account_id"/>
                <filter name="failed" string="Failed" domain="[('status', '!=', 'SENT')]"/>
                <group>
                    <filter name="group_account" string="Number" context="{'group_by': 'account_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Message Log</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
