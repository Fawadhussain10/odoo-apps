<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_partner_ledger" model="ir.actions.report">
        <field name="name">Customer / Vendor Ledger</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">whatsapp_qr_connect.report_partner_ledger</field>
        <field name="report_file">whatsapp_qr_connect.report_partner_ledger</field>
        <field name="print_report_name">'Ledger - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_partner_ledger">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="ledger" t-value="ledgers[o.id]"/>
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="o.with_context(lang=o.lang or env.user.lang)"/>
                    <div class="page">
                        <h2>Account Statement</h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong t-out="o.name"/>
                                <div t-if="o.contact_address" t-out="o.contact_address" class="text-muted small"/>
                            </div>
                            <div class="col-6 text-end">
                                <div>Printed on <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></div>
                                <div>Currency: <span t-out="currency.name"/></div>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Entry</th>
                                    <th>Description</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="ledger['lines']" t-as="line">
                                    <td><span t-out="line['date']"/></td>
                                    <td><span t-out="line['move']"/></td>
                                    <td><span t-out="line['label']"/></td>
                                    <td class="text-end"><span t-out="line['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="line['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="line['balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </tr>
                                <tr t-if="not ledger['lines']">
                                    <td colspan="6" class="text-center text-muted">No posted entries.</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr class="border-black">
                                        <td><strong>Current balance</strong></td>
                                        <td class="text-end">
                                            <strong t-out="ledger['balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </table>
                                <p class="text-muted small" t-out="'A positive balance means the amount is due to %s.' % company.name"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
