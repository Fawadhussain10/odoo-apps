<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sale_tender" model="ir.module.category">
        <field name="name">Tenders</field>
        <field name="sequence">20</field>
    </record>

    <record id="sale_tender_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sale_tender"/>
        <field name="comment">Can access the Tenders app: create tenders and convert
            accepted tenders into quotations.</field>
    </record>

    <record id="sale_tender_group_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_sale_tender"/>
        <field name="implied_ids" eval="[(4, ref('sale_tender_group_user'))]"/>
        <field name="comment">Can Accept or Reject tenders submitted for internal
            approval.</field>
    </record>

    <record id="sale_tender_rule_user_own" model="ir.rule">
        <field name="name">Tender: User sees only own tenders</field>
        <field name="model_id" ref="model_sale_tender"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sale_tender_group_user'))]"/>
    </record>

    <record id="sale_tender_rule_approver_all" model="ir.rule">
        <field name="name">Tender: Approver sees all tenders</field>
        <field name="model_id" ref="model_sale_tender"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sale_tender_group_approver'))]"/>
    </record>
</odoo>
