<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_tender_button" model="ir.ui.view">
        <field name="name">sale.order.view.form.tender.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_tender" type="object"
                        class="oe_stat_button" icon="fa-gavel"
                        invisible="not tender_id">
                    <field name="tender_id" widget="statinfo" string="Tender"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
