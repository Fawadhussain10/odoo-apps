<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cost Sheet -->
    <record id="view_construction_cost_sheet_list" model="ir.ui.view">
        <field name="name">construction.cost.sheet.list</field>
        <field name="model">construction.cost.sheet</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="wbs_id"/>
                <field name="date"/>
                <field name="total_budget_amount" sum="Total"/>
                <field name="total_actual_amount" sum="Total"/>
                <field name="total_variance_amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_construction_cost_sheet_form" model="ir.ui.view">
        <field name="name">construction.cost.sheet.form</field>
        <field name="model">construction.cost.sheet</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="wbs_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="total_budget_amount"/>
                            <field name="total_actual_amount"/>
                            <field name="total_variance_amount"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/>
                            <field name="budget_qty"/>
                            <field name="budget_amount" sum="Budget"/>
                            <field name="actual_qty"/>
                            <field name="actual_amount" sum="Actual"/>
                            <field name="variance_qty"/>
                            <field name="variance_amount" sum="Variance"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_cost_sheet" model="ir.actions.act_window">
        <field name="name">Cost Sheets</field>
        <field name="res_model">construction.cost.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
