<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_rate_analysis_list" model="ir.ui.view">
        <field name="name">construction.rate.analysis.list</field>
        <field name="model">construction.rate.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="date_effective"/>
                <field name="total_rate" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_construction_rate_analysis_form" model="ir.ui.view">
        <field name="name">construction.rate.analysis.form</field>
        <field name="model">construction.rate.analysis</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="date_effective"/>
                        </group>
                        <group>
                            <field name="boq_line_id"/>
                            <field name="boq_template_line_id"/>
                            <field name="total_rate"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="component_type"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="rate"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                    <button name="action_apply_to_boq_line" string="Apply Rate to BOQ Line" type="object"
                            class="btn-secondary mt-2" invisible="not boq_line_id"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_rate_analysis" model="ir.actions.act_window">
        <field name="name">Rate Analysis</field>
        <field name="res_model">construction.rate.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
