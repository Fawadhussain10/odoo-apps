<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_progress_certificate_list" model="ir.ui.view">
        <field name="name">construction.progress.certificate.list</field>
        <field name="model">construction.progress.certificate</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'invoiced'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="certificate_date"/>
                <field name="current_work" sum="Total"/>
                <field name="net_certificate" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_progress_certificate_form" model="ir.ui.view">
        <field name="name">construction.progress.certificate.form</field>
        <field name="model">construction.progress.certificate</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <header>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_create_invoice" string="Create Customer Invoice" type="object" invisible="state != 'approved'" class="btn-primary"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="certificate_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="original_contract"/>
                            <field name="approved_variations"/>
                            <field name="revised_contract"/>
                        </group>
                    </group>
                    <group string="Certificate Amounts">
                        <group>
                            <field name="current_work"/>
                            <field name="stored_material"/>
                            <field name="retention_amount"/>
                        </group>
                        <group>
                            <field name="advance_recovery_pct"/>
                            <field name="advance_recovery"/>
                            <field name="deductions"/>
                            <field name="net_certificate" class="fw-bold"/>
                            <field name="customer_invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/>
                            <field name="rate"/>
                            <field name="certified_qty"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_progress_certificate" model="ir.actions.act_window">
        <field name="name">Progress Certificates</field>
        <field name="res_model">construction.progress.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
