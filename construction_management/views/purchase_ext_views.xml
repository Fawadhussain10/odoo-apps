<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_construction" model="ir.ui.view">
        <field name="name">purchase.order.form.construction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="before">
                <field name="construction_project_id" optional="show"/>
                <field name="construction_wbs_id" optional="hide"/>
                <field name="construction_boq_line_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_requisition_form_construction" model="ir.ui.view">
        <field name="name">purchase.requisition.form.construction</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//list" position="inside">
                <field name="construction_project_id" optional="show"/>
                <field name="construction_boq_line_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
