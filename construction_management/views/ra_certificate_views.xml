<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_ra_certificate_list" model="ir.ui.view">
        <field name="name">construction.ra.certificate.list</field>
        <field name="model">construction.ra.certificate</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'billed'" decoration-info="state == 'approved'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="subcontract_id"/>
                <field name="project_id"/>
                <field name="certificate_date"/>
                <field name="gross_work" sum="Total"/>
                <field name="net_payable" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'billed'"
                       decoration-info="state == 'approved'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_ra_certificate_form" model="ir.ui.view">
        <field name="name">construction.ra.certificate.form</field>
        <field name="model">construction.ra.certificate</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <header>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_create_vendor_bill" string="Create Vendor Bill" type="object" invisible="state != 'approved'" class="btn-primary"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,billed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subcontract_id"/>
                            <field name="measurement_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="certificate_date"/>
                        </group>
                        <group>
                            <field name="gross_work"/>
                            <field name="cumulative_work"/>
                            <field name="retention_amount"/>
                            <field name="advance_recovery_amount"/>
                            <field name="material_recovery_amount"/>
                            <field name="penalty_amount"/>
                            <field name="net_payable" class="fw-bold"/>
                            <field name="vendor_bill_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_ra_certificate" model="ir.actions.act_window">
        <field name="name">RA Certificates</field>
        <field name="res_model">construction.ra.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
