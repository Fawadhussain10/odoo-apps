<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily Site Report -->
    <record id="view_construction_daily_report_list" model="ir.ui.view">
        <field name="name">construction.daily.report.list</field>
        <field name="model">construction.daily.report</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="wbs_id"/>
                <field name="date"/>
                <field name="weather"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_construction_daily_report_form" model="ir.ui.view">
        <field name="name">construction.daily.report.form</field>
        <field name="model">construction.daily.report</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="btn-primary"
                            groups="construction_management.group_construction_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"
                            groups="construction_management.group_construction_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="wbs_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="weather"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Executed" name="executed">
                            <field name="executed_line_ids">
                                <list editable="bottom">
                                    <field name="boq_line_id"/>
                                    <field name="executed_qty"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manpower" name="manpower">
                            <field name="manpower_line_ids">
                                <list editable="bottom">
                                    <field name="trade"/>
                                    <field name="headcount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_line_ids">
                                <list editable="bottom">
                                    <field name="equipment_name"/>
                                    <field name="hours_used" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subcontractors Present" name="subcontractors">
                            <field name="subcontractor_line_ids">
                                <list editable="bottom">
                                    <field name="subcontract_id"/>
                                    <field name="manpower_count" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="delays"/>
                                <field name="instructions"/>
                                <field name="quality_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_daily_report_calendar" model="ir.ui.view">
        <field name="name">construction.daily.report.calendar</field>
        <field name="model">construction.daily.report</field>
        <field name="arch" type="xml">
            <calendar date_start="date" string="Daily Site Reports" color="project_id" mode="month">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_construction_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Site Reports</field>
        <field name="res_model">construction.daily.report</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
