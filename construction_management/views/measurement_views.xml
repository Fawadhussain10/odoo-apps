<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_measurement_list" model="ir.ui.view">
        <field name="name">construction.measurement.list</field>
        <field name="model">construction.measurement</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'commercial_approved'"
                  decoration-info="state in ('site_engineer','qs','pm')" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="subcontract_id"/>
                <field name="project_id"/>
                <field name="measurement_date"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'commercial_approved'"
                       decoration-info="state in ('site_engineer','qs','pm')" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_measurement_form" model="ir.ui.view">
        <field name="name">construction.measurement.form</field>
        <field name="model">construction.measurement</field>
        <field name="arch" type="xml">
            <form class="o_construction_management">
                <header>
                    <button name="action_site_engineer_verify" string="Site Engineer Verify" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_qs_verify" string="QS Verify" type="object" invisible="state != 'site_engineer'" class="btn-primary"/>
                    <button name="action_pm_verify" string="PM Verify" type="object" invisible="state != 'qs'" class="btn-primary"/>
                    <button name="action_commercial_approve" string="Commercial Approve" type="object" invisible="state != 'pm'" class="btn-primary"/>
                    <button name="action_create_ra_certificate" string="Create RA Certificate" type="object" invisible="state != 'commercial_approved' or ra_certificate_id" class="btn-primary"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,site_engineer,qs,pm,commercial_approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subcontract_id"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="measurement_date"/>
                            <field name="total_amount"/>
                            <field name="ra_certificate_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="subcontract_line_id"/>
                            <field name="rate"/>
                            <field name="previous_cumulative_qty"/>
                            <field name="measured_qty"/>
                            <field name="cumulative_qty_after"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_measurement_calendar" model="ir.ui.view">
        <field name="name">construction.measurement.calendar</field>
        <field name="model">construction.measurement</field>
        <field name="arch" type="xml">
            <calendar date_start="measurement_date" string="Measurements" color="subcontract_id" mode="month">
                <field name="name"/>
                <field name="subcontract_id"/>
                <field name="total_amount"/>
            </calendar>
        </field>
    </record>

    <record id="action_construction_measurement" model="ir.actions.act_window">
        <field name="name">Measurements</field>
        <field name="res_model">construction.measurement</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
