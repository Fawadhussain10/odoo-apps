<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== Project BOQ (construction.boq) ==================== -->
    <template id="report_boq_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>
                <h2>
                    Bill of Quantities
                    <span t-field="o.name"/>
                    <span t-if="o.code">(<span t-field="o.code"/>)</span>
                </h2>
                <div id="informations" class="row mb-4">
                    <div class="col" name="boq_project">
                        <strong>Project</strong>
                        <div t-field="o.project_id.name"/>
                    </div>
                    <div class="col" name="boq_revision">
                        <strong>Revision</strong>
                        <div t-field="o.revision_no"/>
                    </div>
                    <div class="col" name="boq_state">
                        <strong>Status</strong>
                        <div t-field="o.state"/>
                    </div>
                    <div class="col" t-if="o.date_approved" name="boq_date_approved">
                        <strong>Approved On</strong>
                        <div t-field="o.date_approved" t-options="{'date_only': True}"/>
                    </div>
                </div>

                <t t-set="lines" t-value="o.line_ids.sorted(key=lambda l: (l.wbs_id.sequence or 0, l.wbs_id.id or 0, l.sequence, l.id))"/>
                <t t-set="prev_wbs" t-value="False"/>
                <t t-set="prev_wbs_set" t-value="False"/>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Item</th>
                            <th class="text-end">UoM</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <t t-if="not prev_wbs_set or line.wbs_id.id != prev_wbs">
                                <tr class="fw-bold" style="background-color:#f2f2f2;">
                                    <td colspan="5">
                                        <span t-if="line.wbs_id" t-field="line.wbs_id.complete_name"/>
                                        <span t-else="">No WBS / Phase</span>
                                    </td>
                                </tr>
                                <t t-set="prev_wbs" t-value="line.wbs_id.id"/>
                                <t t-set="prev_wbs_set" t-value="True"/>
                            </t>
                            <tr t-if="line.display_type == 'subtotal'" class="fw-bold">
                                <td colspan="4"><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'section'" class="fst-italic">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td>
                                    <span t-field="line.name"/>
                                    <div t-if="line.technical_basis" class="text-muted small" t-field="line.technical_basis"/>
                                </td>
                                <td class="text-end"><span t-field="line.uom_id.name"/></td>
                                <td class="text-end"><span t-field="line.net_qty"/></td>
                                <td class="text-end"><span t-field="line.rate" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td class="text-end"><span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="fw-bold border-top">
                                <td>Grand Total</td>
                                <td class="text-end"><span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_boq">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="construction_management.report_boq_document"/>
            </t>
        </t>
    </template>

    <!-- ==================== BOQ Template (construction.boq.template) ==================== -->
    <template id="report_boq_template_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>
                <h2>
                    BOQ Template
                    <span t-field="o.name"/>
                    <span t-if="o.code">(<span t-field="o.code"/>)</span>
                </h2>
                <div id="informations" class="row mb-4">
                    <div class="col" name="tmpl_category">
                        <strong>Category</strong>
                        <div t-field="o.category_id.name"/>
                    </div>
                    <div class="col" name="tmpl_subcategory">
                        <strong>Sub-Category</strong>
                        <div t-field="o.subcategory_id.name"/>
                    </div>
                    <div class="col" name="tmpl_area">
                        <strong>Plot / Covered Area</strong>
                        <div><span t-field="o.plot_area"/> / <span t-field="o.covered_area"/></div>
                    </div>
                    <div class="col" name="tmpl_grade">
                        <strong>Grade</strong>
                        <div t-field="o.grade"/>
                    </div>
                </div>

                <t t-set="lines" t-value="o.line_ids.sorted(key=lambda l: (l.stage_template_id.sequence or 0, l.stage_template_id.id or 0, l.sequence, l.id))"/>
                <t t-set="prev_stage" t-value="False"/>
                <t t-set="prev_stage_set" t-value="False"/>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Item</th>
                            <th class="text-end">UoM</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <t t-if="not prev_stage_set or line.stage_template_id.id != prev_stage">
                                <tr class="fw-bold" style="background-color:#f2f2f2;">
                                    <td colspan="5">
                                        <span t-if="line.stage_template_id" t-field="line.stage_template_id.name"/>
                                        <span t-else="">No Stage</span>
                                    </td>
                                </tr>
                                <t t-set="prev_stage" t-value="line.stage_template_id.id"/>
                                <t t-set="prev_stage_set" t-value="True"/>
                            </t>
                            <tr t-if="line.display_type == 'subtotal'" class="fw-bold">
                                <td colspan="4"><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'section'" class="fst-italic">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td>
                                    <span t-field="line.name"/>
                                    <div t-if="line.technical_basis" class="text-muted small" t-field="line.technical_basis"/>
                                </td>
                                <td class="text-end"><span t-field="line.uom_id.name"/></td>
                                <td class="text-end"><span t-field="line.net_qty"/></td>
                                <td class="text-end"><span t-field="line.rate" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td class="text-end"><span t-field="line.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="fw-bold border-top">
                                <td>Grand Total</td>
                                <td class="text-end"><span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_boq_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="construction_management.report_boq_template_document"/>
            </t>
        </t>
    </template>
</odoo>
