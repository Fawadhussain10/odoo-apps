<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="group_multi_branch" model="res.groups">
            <field name="name">Multi Branches</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record model="ir.module.category" id="module_branch_management">
            <field name="name">Branch Management</field>
            <field name="sequence">11</field>
        </record>

        <record id="group_branch_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            </record>

        <record id="group_branch_user_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_branch_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Branches are now native res.company records (parent_id/child_ids), so
             visibility is governed by Odoo's own company rules + company_ids eval
             context. This rule keeps the original intent: a partner tagged to a
             branch is only visible to users allowed into that branch/company,
             while untagged partners stay shared across all branches. -->
        <record model="ir.rule" id="partner_branch_rule">
            <field name="name">Partner multi-branch</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|',('branch_id','=',False),('branch_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>