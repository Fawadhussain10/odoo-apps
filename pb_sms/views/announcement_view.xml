<?xml version="1.0"?>
<odoo>
    <record id="sms_announcement_search" model="ir.ui.view">
        <field name="name">pb.sms.announcement.search</field>
        <field name="model">pb.sms.announcement</field>
        <field name="arch" type="xml">
            <search string="SMS Announcement">
                <field name="message"/>
                <field name="date"/>
            </search>
        </field>
    </record>

    <record id="sms_announcement_tree_view" model="ir.ui.view">
        <field name="name">pb.sms.announcement.tree.view</field>
        <field name="model">pb.sms.announcement</field>
        <field name="arch" type="xml">
            <list string="SMS Announcement">
                <field name="message"/>
                <field name="employee_selection_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="sms_announcement_form" model="ir.ui.view">
        <field name="name">pb.sms.announcement.form</field>
        <field name="model">pb.sms.announcement</field>
        <field name="arch" type="xml">
            <form string="SMS Announcement">
                <header>
                    <button name="send_message" string="Send" type="object" invisible="state not in ('draft',)" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="message" required="1"/>
                        <group>
                            <field name="announcement_type"/>
                            <field name="employee_selection_type" invisible="announcement_type == 'contacts'"/>
                            <field name="department_id"  required="employee_selection_type == 'department'" invisible="(employee_selection_type != 'department' or announcement_type == 'contacts')"/>
                        </group>
                        <group>
                            <field name="template_id" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <field name="employee_ids" required="employee_selection_type == 'employees'" invisible="(employee_selection_type != 'employees' or announcement_type == 'contacts')"/>
                        <field name="partner_ids" invisible="announcement_type == 'employees'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sms_announcement" model="ir.actions.act_window">
        <field name="name">SMS Announcement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.sms.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to add a Announcement.
            </p>
        </field>
    </record>

</odoo>