<?xml version="1.0"?>
<odoo>

    <!-- <Laboratory> -->
    <record id="patient_radiology_test_request_form" model="ir.ui.view">
        <field name="name">pb.radiology.request.from</field>
        <field name="model">pb.radiology.request</field>
        <field name="inherit_id" ref="pb_radiology.patient_radiology_test_request_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="insurance_id" domain="[('patient_id','=', patient_id), ('allow_radiology_insurance', '=', True)]"/>
                <field name="insurance_company_id"/>
                <field name="claim_id"/>
            </field>
        </field>
    </record>
    
</odoo>