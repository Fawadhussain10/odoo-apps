<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences for Commission -->
        <record id="seq_pb_commission" model="ir.sequence">
            <field name="name">PB HMS Commission</field>
            <field name="code">pb.commission</field>
            <field name="prefix">COMM</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_pb_commission_sheet" model="ir.sequence">
            <field name="name">Commission Summary Sheet</field>
            <field name="code">pb.commission.sheet</field>
            <field name="prefix">CS</field>
            <field name="padding">3</field>
        </record>

        <record id="pb_commission_product" model="product.product">
            <field name="name">Commission</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
        </record>

        <!-- Company Data -->
        <record id="base.main_company" model="res.company" >
            <field name="commission_product_id" ref="pb_commission_product"/>
        </record>

    </data>
</odoo>
