<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction" model="ir.module.category">
        <field name="name">Construction Management</field>
        <field name="sequence">15</field>
    </record>

    <!--
        res.groups no longer has category_id in Odoo 19 (replaced by privilege_id ->
        res.groups.privilege, a radio-style "access level" picker). Only the 4 ladder tiers below
        are mutually-inclusive-ordered (Admin implies Finance implies Manager implies User), so
        only they get a shared privilege for a clean radio widget on the Users form. The named
        role groups (Site Engineer, Storekeeper, ...) are independent, non-exclusive roles at the
        User tier and are intentionally left off the privilege so multiple can be assigned at once.
    -->
    <record id="privilege_construction_access_level" model="res.groups.privilege">
        <field name="name">Construction Access Level</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="sequence">10</field>
    </record>

    <!-- Base operational tier: site engineer, estimator, storekeeper, procurement -->
    <record id="group_construction_user" model="res.groups">
        <field name="name">User: Site / Store / Procurement</field>
        <field name="privilege_id" ref="privilege_construction_access_level"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_construction_site_engineer" model="res.groups">
        <field name="name">Role: Site Engineer</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_storekeeper" model="res.groups">
        <field name="name">Role: Storekeeper</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_estimator" model="res.groups">
        <field name="name">Role: Estimator / QS</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_procurement" model="res.groups">
        <field name="name">Role: Procurement</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- Manager tier: project manager, commercial manager, project accountant -->
    <record id="group_construction_manager" model="res.groups">
        <field name="name">Manager: Project / Commercial</field>
        <field name="privilege_id" ref="privilege_construction_access_level"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_site_engineer')), (4, ref('group_construction_storekeeper')),
                                          (4, ref('group_construction_estimator')), (4, ref('group_construction_procurement')),
                                          (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="group_construction_project_manager" model="res.groups">
        <field name="name">Role: Project Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
    </record>

    <record id="group_construction_commercial_manager" model="res.groups">
        <field name="name">Role: Commercial Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
    </record>

    <record id="group_construction_project_accountant" model="res.groups">
        <field name="name">Role: Project Accountant</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager')), (4, ref('account.group_account_user'))]"/>
    </record>

    <!-- Finance tier: posts WIP journals, approves bills/payments -->
    <record id="group_construction_finance" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="privilege_id" ref="privilege_construction_access_level"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_project_accountant')), (4, ref('group_construction_commercial_manager')),
                                          (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- Admin tier: management, cross-project dashboards, security/config -->
    <record id="group_construction_admin" model="res.groups">
        <field name="name">Management / Administrator</field>
        <field name="privilege_id" ref="privilege_construction_access_level"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_construction_finance')), (4, ref('group_construction_project_manager')),
                                          (4, ref('project.group_project_manager'))]"/>
    </record>

    <!-- Auditor: read-only, not implied by/into any other group -->
    <record id="group_construction_auditor" model="res.groups">
        <field name="name">Auditor (read-only)</field>
    </record>
</odoo>
