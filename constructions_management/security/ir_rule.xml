<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Project-scoped visibility: base-tier users (site engineer/storekeeper/estimator/
        procurement) only see records of projects they manage or are a team member of.
        Manager/finance/admin/auditor tiers see everything (combined with OR per Odoo's rule
        evaluation, since "manager" group membership implies "user" group membership too).
    -->
    <record id="rule_construction_wbs_user" model="ir.rule">
        <field name="name">Construction WBS: own projects only (base tier)</field>
        <field name="model_id" ref="model_construction_wbs"/>
        <field name="domain_force">['|', ('project_id.user_id', '=', user.id), ('project_id.construction_team_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_construction_user'))]"/>
    </record>
    <record id="rule_construction_wbs_all" model="ir.rule">
        <field name="name">Construction WBS: all projects (manager+)</field>
        <field name="model_id" ref="model_construction_wbs"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_manager')), (4, ref('group_construction_auditor'))]"/>
    </record>

