<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Site Receipt -->
    <record id="view_construction_site_receipt_list" model="ir.ui.view">
        <field name="name">construction.site.receipt.list</field>
        <field name="model">construction.site.receipt</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="challan_ref"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_site_receipt_form" model="ir.ui.view">
        <field name="name">construction.site.receipt.form</field>
        <field name="model">construction.site.receipt</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_confirm" string="Confirm Receipt" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="purchase_order_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="challan_ref"/>
                            <field name="vehicle_no"/>
                            <field name="inspector_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="po_line_id"/>
                            <field name="boq_line_id"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="ordered_qty"/>
                            <field name="accepted_qty"/>
                            <field name="rejected_qty"/>
                            <field name="rejection_reason"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_site_receipt" model="ir.actions.act_window">
        <field name="name">Site Receipts</field>
        <field name="res_model">construction.site.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Material Issue -->
    <record id="view_construction_material_issue_list" model="ir.ui.view">
        <field name="name">construction.material.issue.list</field>
        <field name="model">construction.material.issue</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="date"/>
                <field name="issued_to" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_material_issue_form" model="ir.ui.view">
        <field name="name">construction.material.issue.form</field>
        <field name="model">construction.material.issue</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_confirm" string="Confirm Issue" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="wbs_id"/></group>
                        <group><field name="date"/><field name="issued_to"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/><field name="product_id"/><field name="uom_id"/><field name="issued_qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_material_issue" model="ir.actions.act_window">
        <field name="name">Material Issues</field>
        <field name="res_model">construction.material.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Material Consumption -->
    <record id="view_construction_material_consumption_list" model="ir.ui.view">
        <field name="name">construction.material.consumption.list</field>
        <field name="model">construction.material.consumption</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_material_consumption_form" model="ir.ui.view">
        <field name="name">construction.material.consumption.form</field>
        <field name="model">construction.material.consumption</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_confirm" string="Confirm Consumption" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="wbs_id"/></group>
                        <group><field name="date"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/><field name="product_id"/><field name="uom_id"/>
                            <field name="allowed_qty"/><field name="consumed_qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_material_consumption" model="ir.actions.act_window">
        <field name="name">Material Consumption</field>
        <field name="res_model">construction.material.consumption</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Material Return -->
    <record id="view_construction_material_return_list" model="ir.ui.view">
        <field name="name">construction.material.return.list</field>
        <field name="model">construction.material.return</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="name"/><field name="project_id"/><field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_material_return_form" model="ir.ui.view">
        <field name="name">construction.material.return.form</field>
        <field name="model">construction.material.return</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_confirm" string="Confirm Return" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="wbs_id"/></group>
                        <group><field name="date"/><field name="reason"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/><field name="product_id"/><field name="uom_id"/><field name="returned_qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_material_return" model="ir.actions.act_window">
        <field name="name">Material Returns</field>
        <field name="res_model">construction.material.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Material Wastage -->
    <record id="view_construction_material_wastage_list" model="ir.ui.view">
        <field name="name">construction.material.wastage.list</field>
        <field name="model">construction.material.wastage</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-warning="state == 'pending_approval'" decoration-muted="state == 'draft'">
                <field name="name"/><field name="project_id"/><field name="date"/><field name="requires_approval"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending_approval'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_material_wastage_form" model="ir.ui.view">
        <field name="name">construction.material.wastage.form</field>
        <field name="model">construction.material.wastage</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'pending_approval'" class="btn-primary"
                            groups="constructions_management.group_construction_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="wbs_id"/></group>
                        <group><field name="date"/><field name="requires_approval"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/><field name="product_id"/><field name="uom_id"/><field name="wasted_qty"/><field name="reason"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_material_wastage" model="ir.actions.act_window">
        <field name="name">Material Wastage</field>
        <field name="res_model">construction.material.wastage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Inter-Project Transfer -->
    <record id="view_construction_inter_project_transfer_list" model="ir.ui.view">
        <field name="name">construction.inter.project.transfer.list</field>
        <field name="model">construction.inter.project.transfer</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-info="state in ('source_approved','destination_approved')" decoration-muted="state == 'draft'">
                <field name="name"/><field name="source_project_id"/><field name="destination_project_id"/><field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"
                       decoration-info="state in ('source_approved','destination_approved')" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_inter_project_transfer_form" model="ir.ui.view">
        <field name="name">construction.inter.project.transfer.form</field>
        <field name="model">construction.inter.project.transfer</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_source_approve" string="Source Approve" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_destination_approve" string="Destination Approve" type="object" invisible="state != 'source_approved'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="source_project_id"/><field name="destination_project_id"/></group>
                        <group><field name="date"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/><field name="uom_id"/><field name="qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_inter_project_transfer" model="ir.actions.act_window">
        <field name="name">Inter-Project Transfers</field>
        <field name="res_model">construction.inter.project.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Cycle Count -->
    <record id="view_construction_cycle_count_list" model="ir.ui.view">
        <field name="name">construction.cycle.count.list</field>
        <field name="model">construction.cycle.count</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'draft'">
                <field name="name"/><field name="project_id"/><field name="location_id"/><field name="date"/>
                <field name="counted_by" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_cycle_count_form" model="ir.ui.view">
        <field name="name">construction.cycle.count.form</field>
        <field name="model">construction.cycle.count</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_approve" string="Approve &amp; Apply" type="object" invisible="state != 'draft'" class="btn-primary"
                            groups="constructions_management.group_construction_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="location_id"/></group>
                        <group><field name="date"/><field name="counted_by"/><field name="approved_by" readonly="1"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/><field name="system_qty"/><field name="counted_qty"/><field name="variance"/><field name="reason"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_construction_cycle_count" model="ir.actions.act_window">
        <field name="name">Cycle Counts</field>
        <field name="res_model">construction.cycle.count</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
