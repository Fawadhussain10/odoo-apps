<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_material_request_list" model="ir.ui.view">
        <field name="name">construction.material.request.list</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'fulfilled'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'submitted'">
                <field name="code"/>
                <field name="project_id"/>
                <field name="wbs_id"/>
                <field name="operation"/>
                <field name="priority" widget="priority"/>
                <field name="request_by" widget="many2one_avatar_user"/>
                <field name="required_date"/>
                <field name="state" widget="badge" decoration-success="state == 'fulfilled'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_site_approve" string="Site Approve" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                    <button name="action_store_check" string="Store Checked" type="object" invisible="state != 'site_approved'" class="btn-primary"/>
                    <button name="action_procurement_approve" string="Procurement Approve" type="object" invisible="state != 'store_checked'" class="btn-primary"/>
                    <button name="action_create_purchase_requisition" string="Create Purchase Requisition" type="object"
                            invisible="state != 'procurement_approved' or operation != 'consumption'" class="btn-primary"/>
                    <button name="action_create_transfer" string="Create Transfer" type="object"
                            invisible="state not in ('store_checked','procurement_approved') or operation != 'transfer'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('fulfilled','closed','cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,site_approved,store_checked,procurement_approved,rfq_created,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="wbs_id"/>
                            <field name="task_id"/>
                            <field name="request_by"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="source_location_id" invisible="operation != 'transfer'"/>
                            <field name="destination_location_id" invisible="operation != 'transfer'"/>
                            <field name="priority" widget="priority"/>
                            <field name="required_date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="boq_line_id"/>
                            <field name="wbs_id" column_invisible="1"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="requested_qty"/>
                            <field name="available_to_request"/>
                            <field name="justification"/>
                            <field name="proposed_source"/>
                            <field name="is_converted"/>
                            <field name="received_qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_material_request_kanban" model="ir.ui.view">
        <field name="name">construction.material.request.kanban</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <kanban class="o_constructions_management o_kanban_small_column">
                <field name="project_id"/>
                <field name="wbs_id"/>
                <field name="priority"/>
                <field name="request_by"/>
                <field name="required_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click construction-kanban-card">
                            <div class="construction-kanban-card-title">
                                <field name="code"/>
                            </div>
                            <div class="construction-kanban-card-meta text-muted">
                                <field name="project_id"/><t t-if="record.wbs_id.value"> · <field name="wbs_id"/></t>
                            </div>
                            <div class="construction-kanban-card-footer">
                                <field name="state" widget="badge"
                                       decoration-success="state == 'fulfilled'" decoration-danger="state == 'cancelled'"
                                       decoration-warning="state == 'submitted'"/>
                                <span><field name="priority" widget="priority"/></span>
                            </div>
                            <div class="construction-kanban-card-footer">
                                <field name="request_by" widget="many2one_avatar_user"/>
                                <span><field name="required_date"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_construction_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">construction.material.request</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_project_task_form_material_request" model="ir.ui.view">
        <field name="name">project.task.form.construction.material.request</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_create_material_request" icon="fa-truck" invisible="not is_construction_task">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="material_request_count"/></span>
                        <span class="o_stat_text">Material Requests</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[1]" position="before">
                <group invisible="not is_construction_task">
                    <field name="wbs_id"/>
                    <field name="boq_line_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
