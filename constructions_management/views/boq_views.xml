<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_boq_load_template_wizard_form" model="ir.ui.view">
        <field name="name">construction.boq.load.template.wizard.form</field>
        <field name="model">construction.boq.load.template.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="boq_id" invisible="1"/>
                    <field name="template_id"/>
                </group>
                <footer>
                    <button string="Load Lines" type="object" name="action_load" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_construction_boq_list" model="ir.ui.view">
        <field name="name">construction.boq.list</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state in ('superseded',)" decoration-info="state == 'as_built'">
                <field name="code"/>
                <field name="project_id"/>
                <field name="revision_no"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'as_built'"
                       decoration-muted="state == 'superseded'"/>
                <field name="is_current"/>
                <field name="total_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <form class="o_constructions_management">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_negotiate" string="Mark Negotiated" type="object" invisible="state != 'submitted'" class="btn-primary"/>
                    <button name="action_confirm_contract" string="Confirm Contract" type="object" invisible="state != 'negotiated'" class="btn-primary"/>
                    <button name="action_approve" string="Approve Baseline" type="object" invisible="state != 'contract'" class="btn-primary"
                            confirm="Approving locks this BOQ revision as the immutable baseline. Continue?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted','negotiated','contract')"/>
                    <button name="action_create_revision" string="Create Revision" type="object" invisible="state not in ('approved','as_built')"/>
                    <button name="action_mark_as_built" string="Mark As-Built" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,negotiated,contract,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Baseline" bg_color="text-bg-success" invisible="not is_baseline"/>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-secondary" invisible="state != 'superseded'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_load_template_wizard" type="object" class="oe_stat_button" icon="fa-clone"
                                invisible="line_ids or state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Load From Template</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3>
                            <field name="code" readonly="1"/> · Revision <field name="revision_no" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="template_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="previous_revision_id" readonly="1"/>
                            <field name="is_current"/>
                            <field name="date_approved" readonly="1"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Lines">
                            <field name="line_ids" context="{'default_boq_id': id}">
                                <list editable="bottom" decoration-bf="display_type">
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="wbs_id"/>
                                    <field name="work_type_id"/>
                                    <field name="name"/>
                                    <field name="formula_type" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="number"/>
                                    <field name="length" optional="hide"/>
                                    <field name="width" optional="hide"/>
                                    <field name="height" optional="hide"/>
                                    <field name="gross_qty" optional="hide"/>
                                    <field name="waste_pct" optional="hide"/>
                                    <field name="net_qty"/>
                                    <field name="rate"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="revised_net_qty" optional="hide"/>
                                    <field name="revised_amount" optional="hide" sum="Revised Total"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" optional="hide"
                                           groups="account.group_account_readonly"/>
                                    <field name="cost_code_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Execution Tracking">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="revised_net_qty" string="Revised Qty"/>
                                    <field name="requested_qty"/>
                                    <field name="ordered_qty"/>
                                    <field name="received_qty"/>
                                    <field name="issued_qty"/>
                                    <field name="consumed_qty"/>
                                    <field name="certified_qty"/>
                                    <field name="invoiced_qty"/>
                                    <field name="available_to_request"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_boq" model="ir.actions.act_window">
        <field name="name">Project BOQ</field>
        <field name="res_model">construction.boq</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_is_current': 1}</field>
    </record>
</odoo>
