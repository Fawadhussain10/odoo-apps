<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_budget_line_list" model="ir.ui.view">
        <field name="name">construction.boq.line.budget.list</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="variance_pct &lt; -0.05" decoration-warning="variance_pct &lt; 0 and variance_pct &gt;= -0.05" decoration-success="variance_pct &gt;= 0">
                <field name="project_id"/>
                <field name="wbs_id"/>
                <field name="name"/>
                <field name="amount" string="Original Budget" sum="Total"/>
                <field name="revised_amount" string="Revised Budget" sum="Total"/>
                <field name="committed_amount" sum="Total"/>
                <field name="actual_cost" sum="Total"/>
                <field name="etc" sum="Total"/>
                <field name="eac" sum="Total"/>
                <field name="variance_at_completion" sum="Total"/>
                <field name="variance_pct" widget="percentage"/>
                <field name="quantity_variance" optional="hide"/>
                <field name="rate_variance" optional="hide"/>
                <field name="usage_variance" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_construction_budget_pivot" model="ir.ui.view">
        <field name="name">construction.boq.line.budget.pivot</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="project_id" type="row"/>
                <field name="wbs_id" type="row"/>
                <field name="amount" type="measure" string="Original Budget"/>
                <field name="revised_amount" type="measure" string="Revised Budget"/>
                <field name="committed_amount" type="measure"/>
                <field name="actual_cost" type="measure"/>
                <field name="eac" type="measure"/>
                <field name="variance_at_completion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_construction_budget_search" model="ir.ui.view">
        <field name="name">construction.boq.line.budget.search</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="wbs_id"/>
                <filter string="Over Budget" name="over_budget" domain="[('variance_at_completion', '&lt;', 0)]"/>
                <filter string="Baseline Lines Only" name="not_display" domain="[('display_type', '=', False)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="WBS / Phase" name="group_wbs" context="{'group_by': 'wbs_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_budget" model="ir.actions.act_window">
        <field name="name">Budget</field>
        <field name="res_model">construction.boq.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_construction_budget_search"/>
        <field name="context">{'search_default_not_display': 1, 'search_default_group_project': 1, 'search_default_group_wbs': 1}</field>
        <field name="domain">[('boq_id.is_baseline', '=', True)]</field>
    </record>
</odoo>
