<?xml version="1.0" encoding="utf-8"?>
<!--
    NOTE: construction.progress.certificate is being built in parallel by another agent
    (models/wip/progress_certificate.py) and did not exist yet at the time this template was
    written. Field names below are a best guess mirroring construction.ra.certificate's pattern
    (gross_work, cumulative_work, retention_amount, advance_recovery_amount) plus
    stored_material_amount and net_certificate for the customer-facing specifics called out in the
    FDD. Verify/reconcile field names against the real model once it lands - see the calling
    agent's integration notes.
-->
<odoo>
    <template id="report_progress_certificate_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>
                <h2>
                    Progress Certificate
                    <span t-field="o.name"/>
                </h2>
                <div id="informations" class="row mb-4">
                    <div class="col" name="pc_project">
                        <strong>Project</strong>
                        <div t-field="o.project_id.name"/>
                    </div>
                    <div class="col" name="pc_customer">
                        <strong>Customer</strong>
                        <div t-field="o.project_id.partner_id.name"/>
                    </div>
                    <div class="col" name="pc_date">
                        <strong>Certificate Date</strong>
                        <div t-field="o.certificate_date"/>
                    </div>
                    <div class="col" name="pc_state">
                        <strong>Status</strong>
                        <div t-field="o.state"/>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <tbody>
                        <tr>
                            <td>Original Contract</td>
                            <td class="text-end"><span t-field="o.original_contract" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Approved Variations</td>
                            <td class="text-end"><span t-field="o.approved_variations" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Revised Contract</td>
                            <td class="text-end"><span t-field="o.revised_contract" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Current Work Done (This Certificate)</td>
                            <td class="text-end"><span t-field="o.current_work" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Add: Stored / On-Site Material</td>
                            <td class="text-end"><span t-field="o.stored_material" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Less: Retention</td>
                            <td class="text-end">(<span t-field="o.retention_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>)</td>
                        </tr>
                        <tr>
                            <td>Less: Advance Recovery</td>
                            <td class="text-end">(<span t-field="o.advance_recovery" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>)</td>
                        </tr>
                        <tr t-if="o.deductions">
                            <td>Less: Other Deductions</td>
                            <td class="text-end">(<span t-field="o.deductions" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>)</td>
                        </tr>
                        <tr class="fw-bold border-top">
                            <td>Net Certificate Amount</td>
                            <td class="text-end"><span t-field="o.net_certificate" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-5">
                    <div class="col-4 text-center">
                        <div class="border-top pt-1">Prepared By</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="border-top pt-1">Consultant / PM</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="border-top pt-1">Customer Acknowledgement</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_progress_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="constructions_management.report_progress_certificate_document"/>
            </t>
        </t>
    </template>
</odoo>
