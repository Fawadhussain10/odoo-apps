<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="pb_patient_reg_template" model="pb.whatsapp.template">
            <field name="name">PatientRegistartion</field>
            <field name="body_message_type">TEXT</field>
            <field name="body_message">Dear {{ object.name }}, Your Patient Registration No. is {{ object.code }} in PackBytes Hospital. Sent by PackBytes.</field>
        </record>

        <record id="pb_appointment_confirmation_template" model="pb.whatsapp.template">
            <field name="name">AppointmentConfirmation</field>
            <field name="body_message_type">TEXT</field>
            <field name="body_message">Dear {{ object.patient_id.name }}, Your Appointment Registration No. is {{ object.name }}  is confirmed at PackBytes Hospital on {{ object.date.strftime('''%Y-%m-%d''') }}. Sent by PackBytes.</field>
        </record>

        <record id="pb_appointment_reminder_template" model="pb.whatsapp.template">
            <field name="name">AppointmentReminder</field>
            <field name="body_message_type">TEXT</field>
            <field name="body_message">Dear {{ object.patient_id.name }}, Reminder for Your Appointment {{ object.name }} at PackBytes Hospital on {{ object.date.strftime('''%Y-%m-%d''') }}. Sent by PackBytes.</field>
        </record>

        <record id="pb_appointment_reschedule_template" model="pb.whatsapp.template">
            <field name="name">AppointmentReschedule</field>
            <field name="body_message_type">TEXT</field>
            <field name="body_message">Dear {{ object.patient_id.name }}, Your Appointment {{ object.name }} at PackBytes Hospital rescheduled on {{ object.date.strftime('''%Y-%m-%d''') }}. Sent by PackBytes.</field>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="pb_patient_reg_template_id" ref="pb_patient_reg_template"/>
            <field name="pb_appointment_confirmation_template_id" ref="pb_appointment_confirmation_template"/>
            <field name="pb_appointment_reminder_template_id" ref="pb_appointment_reminder_template"/>
            <field name="pb_appointment_reschedule_template_id" ref="pb_appointment_reschedule_template"/>
        </record>

    </data>
</odoo>