<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="main_waiting_screen" model="pb.hms.waiting.screen">
            <field name="name">Appointment: Next Patient Screen</field>
            <field name="code">AWS</field>
            <field name="res_model_id" ref="pb_hms.model_hms_appointment"/>
            <field name="pb_physician_field_id" search="[('model', '=', 'hms.appointment'), ('name', '=', 'physician_id')]"/>
            <field name="pb_patient_field_id" search="[('model', '=', 'hms.appointment'), ('name', '=', 'patient_id')]"/>
            <field name="pb_cabin_field_id" search="[('model', '=', 'hms.appointment'), ('name', '=', 'cabin_id')]"/>
            <field name="pb_state_field_id" search="[('model', '=', 'hms.appointment'), ('name', '=', 'state')]"/>
            <field name="pb_states_to_include">['waiting','in_consultation']</field>
        </record>

    </data>
</odoo>
