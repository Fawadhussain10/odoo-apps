<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <data noupdate="1">

        <record id="group_waiting_screen" model="res.groups">
            <field name="name">Waiting Screen</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


        <record id="pb_hms_waiting_screen_rule" model="ir.rule">
            <field name="name">Waiting Screen multi-company</field>
            <field name="model_id" ref="model_pb_hms_waiting_screen"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>