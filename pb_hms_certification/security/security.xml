<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="0">

        <record id="pb_certification.group_certificate_manager" model="res.groups">
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <record id="hms_certificate_portal_rule_1" model="ir.rule">
            <field name="name">Portal Patient's Own Certificate</field>
            <field name="model_id" ref="pb_certification.model_certificate_management"/>
            <field name="domain_force">[('patient_id.partner_id','=',user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
        </record>

    </data>

</odoo>