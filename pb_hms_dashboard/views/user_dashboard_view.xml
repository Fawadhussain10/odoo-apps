<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    
    <record id="user_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">Dashboard</field>
        <field name="model">res.users</field>
        <field name="type">kanban</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban create="false" class="o_kanban_dashboard o_pb_hms_kanban">
                <field name="name"/>
                <field name="total_patients"/>
                <field name="total_patients_color"/>
                <field name="total_appointments"/>
                <field name="total_appointments_color"/>
                <field name="total_open_invoice"/>
                <field name="total_open_invoice_amount"/>
                <field name="total_open_invoice_color"/>
                <field name="birthday_patients"/>
                <field name="birthday_employee"/>
                <field name="birthday_color"/>
                <field name="appointment_bar_graph"/>
                <field name="appointment_bar_graph_color"/>
                <field name="patient_line_graph"/>
                <field name="patient_line_graph_color"/>

                <field name="my_total_appointments"/>
                <field name="my_total_appointments_color"/>
                <field name="my_total_patients"/>
                <field name="my_total_patients_color"/>
                <field name="my_avg_wait_time"/>
                <field name="my_avg_cons_time"/>
                <field name="my_avg_time_color"/>
                <field name="my_total_treatments"/>
                <field name="my_total_treatments_color"/>

                <field name="avg_wait_time"/>
                <field name="avg_cons_time"/>
                <field name="avg_time_color"/>
                <field name="total_treatments"/>
                <field name="total_treatments_color"/>
                <field name="physicians_color"/>
                <field name="total_physicians"/>
                <field name="total_referring_physicians"/>
                <field name="total_shedules"/>
                <field name="total_shedules_color"/>
                <field name="dashboard_data_filter"/>
                <field name="is_physician"/>
                <field name="is_manager"/>
                <field name="appointment_data"/>
                
                <templates>
                    <t t-name="pb_dashboard_block">
                        <div class="card pb-card h-100" t-attf-style="--pb-accent: #{pb_record_color}">
                            <div class="card-heading">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="stat-icon">
                                        <i t-attf-class="fa #{pb_record_icon}" aria-label="Info" title="Info"></i>
                                    </div>
                                    <div class="text-end">
                                        <div class="value">
                                            <span t-esc="pb_field_name"/>
                                        </div>
                                        <div class="title"><t t-esc="pb_record_lable"/></div>
                                    </div>
                                </div>
                            </div>
                            <a type="object" name="pb_open_dashboard_action" t-attf-context="{'pb_action': '#{pb_record_action}' }">
                                <div class="card-footer pb-footer d-flex align-items-center justify-content-between">
                                    <span>View Details</span>
                                    <i class="fa fa-arrow-circle-right" aria-label="Info" title="Info"></i>
                                </div>
                            </a>
                        </div>
                    </t>

                    <t t-name="pb_dashboard_block_second">
                        <div class="card pb-card h-100" t-attf-style="--pb-accent: #{pb_record_color}">
                            <div class="card-heading">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="stat-icon flex-shrink-0">
                                        <i t-attf-class="fa #{pb_record_icon}" aria-label="Info" title="Info"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="row">
                                            <div class="col-6 text-center my-auto">
                                                <a type="object" name="pb_open_dashboard_action" t-attf-context="{'pb_action': '#{pb_record_action}' }">
                                                    <div class="value big-pb-number">
                                                        <span t-esc="pb_field_name"/>
                                                    </div>
                                                    <div class="title small">
                                                        <t t-esc="pb_record_lable"/>
                                                    </div>
                                                </a>
                                            </div>

                                            <div class="col-6 text-center my-auto">
                                                <a type="object" name="pb_open_dashboard_action" t-attf-context="{'pb_action': '#{pb_record2_action}' }">
                                                    <div class="value big-pb-number">
                                                        <span t-esc="pb_field2_name"/>
                                                    </div>
                                                    <div class="title small">
                                                        <t t-esc="pb_record2_lable"/>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                        <hr class="pb-hr"/>
                                        <div class="text-center title"><t t-esc="pb_lable"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-name="card">
                        <div id="pb_hms_dashboard" class="">
                            <div class="pb-dash-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div>
                                    <h2 class="pb-dash-title">Welcome back, <t t-esc="record.name.raw_value"/></h2>
                                    <div class="pb-dash-subtitle">Here's what's happening across your hospital</div>
                                </div>
                                <div class="btn-group" role="group" aria-label="Filters">
                                    <button t-attf-class="btn #{record.dashboard_data_filter.raw_value=='today' ? 'btn-primary' : 'btn-secondary'}" type="object" name="today_data">Today</button>
                                    <button t-attf-class="btn #{record.dashboard_data_filter.raw_value=='week' ? 'btn-primary' : 'btn-secondary'}" type="object" name="week_data">This Week</button>
                                    <button t-attf-class="btn #{record.dashboard_data_filter.raw_value=='month' ? 'btn-primary' : 'btn-secondary'}" type="object" name="month_data">This Month</button>
                                    <button t-attf-class="btn #{record.dashboard_data_filter.raw_value=='all' ? 'btn-primary' : 'btn-secondary'}" type="object" name="all_data">Till Now</button>
                                </div>
                            </div>
                            <div class="pb-section-label">Overview</div>
                            <div class="row">
                                <!-- Total Patients -->
                                <div groups="pb_hms.group_hms_receptionist" t-if="!record.is_physician.raw_value or record.is_manager.raw_value" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block">
                                        <t t-set="pb_record_color" t-value="record.total_patients_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-wheelchair'"/>
                                        <t t-set="pb_field_name" t-value="record.total_patients.raw_value"/>
                                        <t t-set="pb_record_lable">Patients</t>
                                        <t t-set="pb_record_action" t-value="'open_patients'"/>
                                    </t>
                                </div>

                                <!-- My Patients -->
                                <div groups="pb_hms.group_hms_jr_doctor" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block">
                                        <t t-set="pb_record_color" t-value="record.my_total_patients_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-wheelchair'"/>
                                        <t t-set="pb_field_name" t-value="record.my_total_patients.raw_value"/>
                                        <t t-set="pb_record_lable">My Total Patients</t>
                                        <t t-set="pb_record_action" t-value="'open_my_patients'"/>
                                    </t>
                                </div>

                                <!-- Physicians -->
                                <div class="col-xl-3 col-lg-4 col-md-6 pb_block" groups="pb_hms_base.group_hms_manager">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.physicians_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-user-md'"/>
                                        <t t-set="pb_field_name" t-value="record.total_physicians.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_physicians'"/>
                                        <t t-set="pb_record_lable">Total Phy.</t>
                                        <t t-set="pb_field2_name" t-value="record.total_referring_physicians.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_referring_physicians'"/>
                                        <t t-set="pb_record2_lable">Ref. Phy.</t>
                                        <t t-set="pb_lable">Physicians</t>
                                    </t>
                                </div>

                                <!-- Appointments --> 
                                <div groups="pb_hms.group_hms_receptionist" t-if="!record.is_physician.raw_value or record.is_manager.raw_value" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block">
                                        <t t-set="pb_record_color" t-value="record.total_appointments_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-stethoscope'"/>
                                        <t t-set="pb_field_name" t-value="record.total_appointments.raw_value"/>
                                        <t t-set="pb_record_lable">Appointments</t>
                                        <t t-set="pb_record_action" t-value="'open_appointments'"/>
                                    </t>
                                </div>

                                <!-- My Appointments -->
                                <div groups="pb_hms.group_hms_jr_doctor" t-if="record.is_physician.raw_value" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block">
                                        <t t-set="pb_record_color" t-value="record.my_total_appointments_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-stethoscope'"/>
                                        <t t-set="pb_field_name" t-value="record.my_total_appointments.raw_value"/>
                                        <t t-set="pb_record_lable">My Appointments</t>
                                        <t t-set="pb_record_action" t-value="'open_my_appointments'"/>
                                    </t>
                                </div>

                                <!-- Schedules -->
                                <div groups="pb_hms.group_hms_receptionist" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block">
                                        <t t-set="pb_record_color" t-value="record.total_shedules_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-calendar'"/>
                                        <t t-set="pb_field_name" t-value="record.total_shedules.raw_value"/>
                                        <t t-set="pb_record_lable">Total Shedules</t>
                                        <t t-set="pb_record_action" t-value="'open_shedules'"/>
                                    </t>
                                </div>

                                <!-- Open Invoices -->
                                <div class="col-xl-3 col-lg-4 col-md-6 pb_block" groups="account.group_account_invoice">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.total_open_invoice_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-list'"/>
                                        <t t-set="pb_field_name" t-value="record.total_open_invoice.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_invoices'"/>
                                        <t t-set="pb_record_lable">Total</t>
                                        <t t-set="pb_field2_name" t-value="record.total_open_invoice_amount.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_invoices'"/>
                                        <t t-set="pb_record2_lable">Amount</t>
                                        <t t-set="pb_lable">Open Invoices</t>
                                    </t>
                                </div>

                                <!-- Treatments --> 
                                <div class="col-xl-3 col-lg-4 col-md-6 pb_block" groups="pb_hms.group_hms_receptionist" t-if="!record.is_physician.raw_value or record.is_manager.raw_value">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.total_treatments_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-user-md'"/>
                                        <t t-set="pb_field_name" t-value="record.total_treatments.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_running_treatments'"/>
                                        <t t-set="pb_record_lable">Running</t>
                                        <t t-set="pb_field2_name" t-value="record.total_treatments.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_treatments'"/>
                                        <t t-set="pb_record2_lable">Total</t>
                                        <t t-set="pb_lable">Treatments</t>
                                    </t>
                                </div>

                                <!-- My Treatments --> 
                                <div class="col-xl-3 col-lg-4 col-md-6 pb_block" groups="pb_hms.group_hms_jr_doctor" t-if="record.is_physician.raw_value">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.my_total_treatments_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-user-md'"/>
                                        <t t-set="pb_field_name" t-value="record.my_total_treatments.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_my_running_treatments'"/>
                                        <t t-set="pb_record_lable">Running</t>
                                        <t t-set="pb_field2_name" t-value="record.my_total_treatments.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_my_treatments'"/>
                                        <t t-set="pb_record2_lable">Total</t>
                                        <t t-set="pb_lable">My Treatments</t>
                                    </t>
                                </div>

                                <!-- Avg Time -->
                                <div groups="pb_hms_base.group_hms_manager" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.avg_time_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-clock-o'"/>
                                        <t t-set="pb_field_name" t-value="record.avg_wait_time.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_appointments'"/>
                                        <t t-set="pb_record_lable">Wait Time</t>
                                        <t t-set="pb_field2_name" t-value="record.avg_cons_time.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_appointments'"/>
                                        <t t-set="pb_record2_lable">Cons. Time</t>
                                        <t t-set="pb_lable">Average Time</t>
                                    </t>
                                </div>

                                <!-- My Avg Time -->
                                <div groups="pb_hms.group_hms_jr_doctor" t-if="record.is_physician.raw_value" class="col-xl-3 col-lg-4 col-md-6 pb_block">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.my_avg_time_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-clock-o'"/>
                                        <t t-set="pb_field_name" t-value="record.my_avg_wait_time.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_my_appointments'"/>
                                        <t t-set="pb_record_lable">Wait Time</t>
                                        <t t-set="pb_field2_name" t-value="record.my_avg_cons_time.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_my_appointments'"/>
                                        <t t-set="pb_record2_lable">Cons. Time</t>
                                        <t t-set="pb_lable">My Average Time</t>
                                    </t>
                                </div>

                                <!-- Todays Birthdays --> 
                                <div class="col-xl-3 col-lg-4 col-md-6 pb_block" groups="pb_hms.group_hms_receptionist">
                                    <t t-call="pb_dashboard_block_second">
                                        <t t-set="pb_record_color" t-value="record.birthday_color.raw_value"/>
                                        <t t-set="pb_record_icon" t-value="'fa-birthday-cake'"/>
                                        <t t-set="pb_field_name" t-value="record.birthday_employee.raw_value"/>
                                        <t t-set="pb_record_action" t-value="'open_birthday_employee'"/>
                                        <t t-set="pb_record_lable">Employee</t>
                                        <t t-set="pb_field2_name" t-value="record.birthday_patients.raw_value"/>
                                        <t t-set="pb_record2_action" t-value="'open_birthday_patients'"/>
                                        <t t-set="pb_record2_lable">Patient</t>
                                        <t t-set="pb_lable">Todays Birthday</t>
                                    </t>
                                </div>
                            </div>

                            <div class="pb-section-label">Today's Activity</div>
                            <div class="row" id="appointment_list" groups="pb_hms.group_hms_receptionist">
                                <div class="col-12 mb32">
                                    <t t-value="JSON.parse(record.appointment_data.raw_value)" t-set="appointment_data"/>
                                    <div class="card pb-card pb-appt-card">
                                        <div class="card-header d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <span>Appointments</span>
                                                <span class="pb-count-chip" t-esc="appointment_data.length"/>
                                            </div>
                                            <a type="object" name="open_appointments" class="pb-view-all" title="This will show max 20 records only">
                                                View All <i class="fa fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                        <div class="card-body p-0" t-if="appointment_data.length">
                                            <div class="table-responsive">
                                                <table class="table">
                                                    <thead>
                                                        <tr>
                                                            <th>Appointment</th>
                                                            <th>Patient</th>
                                                            <th>Date</th>
                                                            <th>Physician</th>
                                                            <th>Wait Time</th>
                                                            <th>Consultation Time</th>
                                                            <th>State</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <tr t-foreach="appointment_data" t-as="line">
                                                            <td><span class="fw-semibold" t-esc="line.name"/></td>
                                                            <td><span t-esc="line.patient"/></td>
                                                            <td><span class="text-muted" t-esc="line.date"/></td>
                                                            <td><span t-esc="line.physician"/></td>
                                                            <td><span class="pb-time-chip" t-esc="line.waiting_duration"/></td>
                                                            <td><span class="pb-time-chip" t-esc="line.appointment_duration"/></td>
                                                            <td>
                                                                <span t-attf-class="pb-badge pb-badge-#{line.state == 'Done' ? 'success' : line.state == 'Cancelled' ? 'danger' : line.state == 'Waiting' ? 'warning' : line.state == 'In consultation' ? 'info' : line.state == 'To Invoice' ? 'primary' : 'neutral'}" t-esc="line.state"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="pb-empty-state" t-if="!appointment_data.length">
                                            <i class="fa fa-calendar-check-o"></i>
                                            <div>No appointments to show</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Graphs -->
                            <div class="pb-section-label" groups="pb_hms.group_hms_receptionist">Analytics</div>
                            <div class="row" id="dashboard_graphs" groups="pb_hms.group_hms_receptionist">
                                <div class="col-12">
                                    <div class="card pb-card pb-graph-card" t-attf-style="--pb-accent: #{record.appointment_bar_graph_color.raw_value}">
                                        <div class="card-heading d-flex align-items-center gap-3">
                                            <div class="pb-graph-icon">
                                                <i class="fa fa-bar-chart" aria-label="Info" title="Info"></i>
                                            </div>
                                            <div>
                                                <div class="pb-graph-title">Patient Appointments</div>
                                                <div class="pb-graph-subtitle">Appointment volume trend</div>
                                            </div>
                                        </div>
                                        <div class="card-body o_pb_dashboard_graph">
                                            <t t-name="JournalBodyGraph">
                                                <field name="appointment_bar_graph" graph_type="bar" widget="dashboard_graph"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card pb-card pb-graph-card" t-attf-style="--pb-accent: #{record.patient_line_graph_color.raw_value}">
                                        <div class="card-heading d-flex align-items-center gap-3">
                                            <div class="pb-graph-icon">
                                                <i class="fa fa-line-chart" aria-label="Info" title="Info"></i>
                                            </div>
                                            <div>
                                                <div class="pb-graph-title">New Patients</div>
                                                <div class="pb-graph-subtitle">New patient registrations</div>
                                            </div>
                                        </div>
                                        <div class="card-body o_pb_dashboard_graph">
                                            <t t-name="JournalBodyGraph">
                                                <field name="patient_line_graph" graph_type="line" widget="dashboard_graph"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_my_dashboard" model="ir.actions.act_window">
        <field name="name">My Dashboard</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="user_dashboard_kanban_view"/>
        <field name="usage">menu</field>
        <field name="domain">[('id','=',uid)]</field>
    </record>

    <menuitem id="main_dashboard" name="My Dashboard" sequence="0"
        web_icon="pb_hms_dashboard,static/description/icon.png" groups="pb_hms_dashboard.group_hms_dashboard"/>
    <menuitem id="dashboard_menu" name="Dashboard" parent="main_dashboard"
        action="action_my_dashboard" sequence="1"/>

</odoo>
