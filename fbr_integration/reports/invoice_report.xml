<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template inherit_id="account.report_invoice_document" id="invoice_report_fbr_inherit">
            <xpath expr="//div[@class='clearfix invoice_main'][1]/div[@class='page mb-4']/table[1]/thead[1]/tr[1]/th[5]"
                   position="replace"/>
            <xpath expr="//div[@class='clearfix invoice_main'][1]/div[@class='page mb-4']/table[1]/tbody[1]/t[4]/tr[1]/t[1]/td[5]"
                   position="replace"/>
            <xpath expr="//div[@class='clearfix invoice_main'][1]/div[@class='page mb-4']/table[1]/thead[1]/tr[1]//th[1]"
                   position="after">
                <th name="th_hs_code" class="text-start">
                    <span>HS Code</span>
                </th>
            </xpath>
            <xpath expr="//div[@class='clearfix invoice_main'][1]/div[@class='page mb-4']/table[1]/tbody[1]/t[4]/tr[1]/t[1]/td[1]"
                   position="after">
                <td name="account_invoice_line_hs_code">
                    <span t-if="line.pct_code" t-field="line.pct_code" t-options="{'widget': 'text'}">0000.0000</span>
                </td>
            </xpath>
            <xpath expr="//div[@class='clearfix invoice_main'][1]" position="after">
                <t t-if="o.fbr_invoice_number">
                    <div class="mt16" style="text-align: center;">
                        <strong>FBR Invoice No#</strong>
                    </div>
                    <div class="mt16" style="text-align: center;">
                        <strong>
                            <t t-esc="o.fbr_invoice_number"/>
                        </strong>
                    </div>
                </t>
                <div class="mt16" style="text-align: center;">
                    <t t-if="o.fbr_qr_image">
                        <img t-att-src="'/fbr_integration/static/description/icon.png'"
                             style="width: 170px; height: 170px;" alt="FBR Logo"/>
                        <img t-att-src="image_data_uri(o.fbr_qr_image)"
                             style="width: 150px; height: 150px;" alt="FBR QR Code"/>
                    </t>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
